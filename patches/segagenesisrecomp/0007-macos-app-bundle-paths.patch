+#ifdef __APPLE__
+/* A double-clicked TG2Recomp.app runs from X.app/Contents/MacOS. Anchor the
+ * cartridge search and user data on the folder the player actually sees (the
+ * one containing X.app), and fall back to Application Support when the app
+ * sits in a read-only location such as /Applications. Assets are unaffected:
+ * SDL_GetBasePath() already reports Contents/Resources for a bundle. */
+static void macos_bundle_paths(void)
+{
+    char exe_dir[sizeof s_exe_dir];
+    char parent[sizeof s_exe_dir];
+    char data_dir[sizeof s_data_dir];
+    if (!genesis_macos_executable_dir(exe_dir, sizeof exe_dir)) return;
+    snprintf(s_exe_dir, sizeof s_exe_dir, "%s", exe_dir);
+    if (!genesis_macos_bundle_parent(exe_dir, parent, sizeof parent)) return;
+    snprintf(s_exe_dir, sizeof s_exe_dir, "%s", parent);
+    if (genesis_path_is_writable(parent)) {
+        snprintf(s_data_dir, sizeof s_data_dir, "%s", parent);
+    } else if (genesis_macos_app_support(data_dir, sizeof data_dir)) {
+        snprintf(s_data_dir, sizeof s_data_dir, "%s", data_dir);
+        fprintf(stderr, "[paths] bundle folder is read-only; user data: %s\n", s_data_dir);
+    }
+}
+#endif
