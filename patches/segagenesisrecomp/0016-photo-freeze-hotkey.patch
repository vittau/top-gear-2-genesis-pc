From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Subject: [PATCH] runner: P freezes the game for screenshots

P stops emulation on the current frame without the game's own pause
screen; P or Esc resumes. Off until pressed.
---
diff --git a/runner/main.c b/runner/main.c
--- a/runner/main.c
+++ b/runner/main.c
@@ -926,6 +926,10 @@
 static uint32_t s_current_frame_for_input = 0;
 
 /* TCP debug server input override (set_input command) */
+/* Photo freeze (P): stop the game exactly where it is, without the game's own
+ * pause screen, so the player can line up a screenshot. Toggled by P; nothing
+ * changes while it is off. */
+static int      s_photo_freeze = 0;
 static int      s_tcp_input_active = 0;
 static uint8_t  s_tcp_input_keys   = 0;  /* Genesis: Up=0,Down=1,Left=2,Right=3,B=4,C=5,A=6,Start=7 */
 #if GENESIS_HAS_RECOMP_NET
@@ -3617,6 +3621,28 @@
             continue;   /* re-check at loop top */
         }
 
+        if (s_photo_freeze
+#if GENESIS_HAS_RECOMP_NET
+            && !genesis_netplay_active()
+#endif
+            ) {
+            SDL_Event pev;
+            while (window_poll_event(&pev)) {
+                gamepad_handle_event(&pev);
+                if (pev.type == SDL_QUIT) { running = 0; window_close_requested = 1; break; }
+                if (pev.type == SDL_KEYDOWN && !pev.key.repeat &&
+                    (pev.key.keysym.sym == SDLK_p || pev.key.keysym.sym == SDLK_ESCAPE))
+                    s_photo_freeze = 0;
+            }
+            if (!running) break;
+            if (s_debug_enabled) {
+                CmdResult pcr = cmd_server_poll();
+                if (pcr.should_quit) { running = 0; break; }
+            }
+            SDL_Delay(10);
+            continue;
+        }
+
         int overlay_request = 0;
         SDL_Event ev;
         while (window_poll_event(&ev)) {
@@ -3637,6 +3663,10 @@
 #endif
             if (ev.type == SDL_QUIT) { running = 0; window_close_requested = 1; break; }
             if (ev.type == SDL_KEYDOWN) {
+                if (!ev.key.repeat && !(ev.key.keysym.mod & (KMOD_SHIFT | KMOD_CTRL | KMOD_ALT | KMOD_GUI)) &&
+                    ev.key.keysym.sym == SDLK_p) {
+                    s_photo_freeze = 1; continue;
+                }
                 if (!ev.key.repeat && !(ev.key.keysym.mod & (KMOD_SHIFT | KMOD_CTRL)) &&
                     ev.key.keysym.sym == SDLK_F7) {
                     overlay_request = 2; continue;
