From efb91660cd3cbcda724243caa57efb36e680ef75 Mon Sep 17 00:00:00 2001
From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Date: Thu, 12 Nov 2026 10:52:20 -0300
Subject: [PATCH] Expose game scale vocabulary and runtime menu layout

Use the game render-scale choices and host menu layout after the complete runtime settings surface has been assembled.
---
 runner/game_spec.h | 19 ++++++++++++++++
 runner/main.c      | 56 ++++++++++++++++++++++++++++++++++++++++++----
 2 files changed, 71 insertions(+), 4 deletions(-)

diff --git a/runner/game_spec.h b/runner/game_spec.h
index 94f1af3..cee8b19 100644
--- a/runner/game_spec.h
+++ b/runner/game_spec.h
@@ -38,6 +38,22 @@ typedef struct {
     void      (*handler)(int id, const char *json_line);
 } GameDebugCommand;
 
+/* Optional game-owned vocabulary for the shared "Internal resolution" row.
+ * The row normally offers the engine's supersampling ladder (1,2,4,...64) and
+ * drives the engine's own HD path. A game whose video provider reads the
+ * render scale itself (a game-owned high-resolution renderer) supplies its own
+ * values, labels and text instead: `values` are the settings.ini
+ * internal_scale numbers the provider understands, in display order, and the
+ * row stores one of them. All arrays are borrowed and must stay valid for the
+ * process lifetime (static data). NULL keeps the engine ladder unchanged. */
+typedef struct GameInternalScale {
+    const int *values;
+    const char *const *labels;
+    int count;
+    const char *description;  /* in-game (Esc) menu row text, or NULL */
+    const char *note;         /* launcher note drawn under the row, or NULL */
+} GameInternalScale;
+
 typedef struct GameSpec {
     const GameVideo *video;          /* NULL = native VDP presentation only */
     /* Custom-video mode for a fresh install (no saved [mods.widescreen]
@@ -67,6 +83,7 @@ typedef struct GameSpec {
      * returned RecompRuntimeUiItem array and its strings must stay valid for
      * the lifetime of the menu. get/set receive the item's key. */
     const struct RecompRuntimeUiItem *(*runtime_ui_items)(size_t *count);
+    const struct RecompRuntimeUiLayout *runtime_ui_layout;
     int (*runtime_ui_get)(const char *key, int *out);
     int (*runtime_ui_set)(const char *key, int value);
     /* Game-owned additive features may compose with the common video provider. */
@@ -316,6 +333,8 @@ typedef struct GameSpec {
      * one function at a time during divergence hunting. NULL+0 is
      * legal and means "no overrides". */
 
+    /* Game-owned Internal resolution vocabulary (see GameInternalScale). */
+    const GameInternalScale *internal_scale;
 } GameSpec;
 
 /*
diff --git a/runner/main.c b/runner/main.c
index eecc5ff..d522692 100644
--- a/runner/main.c
+++ b/runner/main.c
@@ -337,6 +337,32 @@ static const char *const s_hd_labels[]={"Native","2x","4x","8x","16x","32x","64x
 static const RecompRuntimeUiItem s_hd_items[]={
     {"video.internal_resolution","Video","Internal resolution (restart)","Applies next launch. Unsupported hardware keeps native presentation.",RECOMP_RUNTIME_UI_CHOICE,0,6,1,s_hd_labels,7,NULL}
 };
+/* A game-owned render scale replaces the engine ladder (GameInternalScale):
+ * same row key and settings.ini value (internal_scale), the game's own values
+ * and labels. */
+static const GameInternalScale *game_internal_scale(void) {
+    const GameInternalScale *g=g_game_spec.internal_scale;
+    return g && g->values && g->labels && g->count>0 ? g : NULL;
+}
+static const int *hd_scale_values(void) {
+    const GameInternalScale *g=game_internal_scale();
+    return g ? g->values : s_hd_scales;
+}
+static int hd_scale_count(void) {
+    const GameInternalScale *g=game_internal_scale();
+    return g ? g->count : 7;
+}
+static RecompRuntimeUiItem hd_scale_item(void) {
+    RecompRuntimeUiItem item=s_hd_items[0];
+    const GameInternalScale *g=game_internal_scale();
+    if(g) {
+        if(g->labels) item.choices=g->labels;
+        if(g->description) item.description=g->description;
+        item.choice_count=(size_t)g->count;
+        item.maximum=g->count-1;
+    }
+    return item;
+}
 static const RecompRuntimeUiItem s_video_mod_items[]={
     {"mods.widescreen.enabled","Mods","Widescreen","Opt-in custom scene renderer with expanded objects and screen-anchored HUD.",RECOMP_RUNTIME_UI_BOOL,0,1,1},
     {"mods.widescreen.aspect","Mods","Aspect ratio","Adaptive follows the whole window without a 32:9 cap.",RECOMP_RUNTIME_UI_CHOICE,0,3,1,s_mod_aspects,4}
@@ -364,7 +390,8 @@ static int runtime_ui_get(void *p, const RecompRuntimeUiItem *i, int *out) {
     else if (!strcmp(i->key,"mods.diagnostics.enabled")) *out=g_app_config.replay_diagnostics;
     else if (!strcmp(i->key,"states.slot")) *out = s_quickstate_slot;
     else if (!strcmp(i->key,"video.internal_resolution")) {
-        *out=0;for(int n=0;n<7;++n)if(s_hd_scales[n]==g_app_config.internal_scale)*out=n;
+        const int *values=hd_scale_values();int count=hd_scale_count();
+        *out=0;for(int n=0;n<count;++n)if(values[n]==g_app_config.internal_scale)*out=n;
     }
     else if (g_game_spec.runtime_ui_get && g_game_spec.runtime_ui_get(i->key, out)) return 1;
     else return 0; return 1;
@@ -372,8 +399,9 @@ static int runtime_ui_get(void *p, const RecompRuntimeUiItem *i, int *out) {
 static int runtime_ui_set(void *p, const RecompRuntimeUiItem *i, int v) {
     RuntimeUiContext *c = (RuntimeUiContext *)p;
     if(!strcmp(i->key,"video.internal_resolution")) {
-        if(v<0||v>6)return 0;
-        g_app_config.internal_scale=s_hd_scales[v];return 1;
+        const int *values=hd_scale_values();int count=hd_scale_count();
+        if(v<0||v>=count)return 0;
+        g_app_config.internal_scale=values[v];return 1;
     }
     if (!strcmp(i->key,"states.slot")) { if (v<1 || v>9) return 0; s_quickstate_slot=v; return 1; }
     if(!strcmp(i->key,"audio.bypass_filter")) {
@@ -2657,6 +2685,11 @@ static int run_recomp_launcher(const char *ltitle, const char *initial_rom, char
         ls.audio_freq       = g_app_config.audio_freq;
         ls.volume           = g_app_config.volume;
         ls.skip_launcher    = g_app_config.skip_launcher;
+        /* A game-owned render scale round-trips through the launcher's
+         * Internal resolution row (see GameInternalScale). Seed the current
+         * value; it is read back below and persisted in settings.ini. */
+        if (game_internal_scale())
+            ls.internal_resolution = g_app_config.internal_scale;
 #ifdef RECOMP_LAUNCHER_HAS_REWIND_ENABLED
         ls.rewind_enabled   = g_app_config.rewind_enabled;
 #endif
@@ -2695,6 +2728,14 @@ static int run_recomp_launcher(const char *ltitle, const char *initial_rom, char
         gi.rom_noun             = "ROM";
         gi.pad_mode_supported   = 1;   /* 3-Button / 6-Button selector */
         gi.pad_mode_selectable  = 1;
+        if (game_internal_scale()) {
+            const GameInternalScale *g=game_internal_scale();
+            gi.has_supersampling = 1;
+            gi.internal_resolution_labels = g->labels;
+            gi.internal_resolution_values = g->values;
+            gi.num_internal_resolutions = g->count;
+            gi.internal_resolution_note = g->note;
+        }
 #ifdef RECOMP_LAUNCHER_HAS_REWIND_DEPTH
         gi.has_rewind_depth     = 1;
 #endif
@@ -2769,6 +2810,12 @@ static int run_recomp_launcher(const char *ltitle, const char *initial_rom, char
             g_app_config.volume           = ls.volume;
             g_app_config.audio_freq       = ls.audio_freq;
             g_app_config.skip_launcher    = ls.skip_launcher;
+            if (game_internal_scale()) {
+                const int *values=hd_scale_values();int count=hd_scale_count();
+                for (int n=0;n<count;++n)
+                    if (values[n]==ls.internal_resolution)
+                        g_app_config.internal_scale=ls.internal_resolution;
+            }
 #ifdef RECOMP_LAUNCHER_HAS_REWIND_ENABLED
             g_app_config.rewind_enabled   = ls.rewind_enabled != 0;
 #endif
@@ -3839,6 +3886,7 @@ int main(int argc, char *argv[])
         cfg.menu.callbacks.context = &s_runtime_ui; cfg.menu.callbacks.get_value = runtime_ui_get;
         cfg.menu.callbacks.set_value = runtime_ui_set; cfg.menu.callbacks.run_action = runtime_ui_action;
         cfg.menu.callbacks.save = runtime_ui_save;
+        cfg.menu.layout = g_game_spec.runtime_ui_layout;
         cfg.menu.callbacks.visibility_changed = input_gameplay_capture_changed;
         cfg.features = RECOMP_RUNTIME_UI_STANDARD_FULLSCREEN | RECOMP_RUNTIME_UI_STANDARD_WINDOW_SCALE |
             RECOMP_RUNTIME_UI_STANDARD_VIEW_MODE | RECOMP_RUNTIME_UI_STANDARD_LINEAR_FILTER |
@@ -3858,7 +3906,7 @@ int main(int argc, char *argv[])
                 items[count++]=s_presentation_item;
             items[count++]=s_audio_filter_item;
             items[count++]=s_diagnostics_item;
-            memcpy(items+count,s_hd_items,sizeof s_hd_items);++count;
+            items[count++]=hd_scale_item();
             if (!g_game_spec.state_unavailable_reason || !g_game_spec.state_unavailable_reason()) {
                 memcpy(items+count,s_quickstate_items,sizeof s_quickstate_items);count+=3;
             }
