diff --git a/runner/audio.c b/runner/audio.c
index 3c9acc4..3aa8269 100644
--- a/runner/audio.c
+++ b/runner/audio.c
@@ -1,4 +1,5 @@
 #include "audio.h"
+#include "audio/mixer.h"
 #include "host_stream.h"
 #include <SDL2/SDL.h>
 #include <stdio.h>
@@ -126,6 +127,13 @@ static FILE *s_wav_file = NULL;
 static GenesisHostStream *s_wav_stream;
 static uint32_t s_wav_data_bytes = 0;
 
+/* Forward declarations for the chip export / mix helper (defined below). */
+static void wav_write_header(FILE *f, uint32_t sample_rate, uint32_t data_bytes);
+static void mix_frame_into(int16_t *out, size_t out_n,
+                           const int16_t *fm_buf, size_t fm_frames,
+                           const int16_t *psg_buf, size_t psg_frames);
+static void chip_dump_stop(void);
+
 /* Scratch output buffer — sized for worst-case PSG frames per video frame.
  * PSG rate ~223721 Hz / 50 Hz (PAL) ≈ 4475 frames.  Double for headroom. */
 #define OUT_BUF_FRAMES 16384
@@ -270,6 +278,7 @@ int audio_init(int psg_sample_rate)
 void audio_close(void)
 {
     s_extra_source = NULL;
+    chip_dump_stop();
     if (s_dev != 0) {
         SDL_LockAudioDevice(s_dev);
         if (s_buffer_trace) {
@@ -344,6 +353,101 @@ void audio_discard_playback(void)
     SDL_UnlockAudioDevice(s_dev);
 }
 
+/* Fixed-ratio mix: PSG at ratio 1 (÷8 like the reference mixer), FM
+ * upsampled to the PSG rate. Exactly the arithmetic audio_flush always used;
+ * factored out so the per-chip BOTH-mode export can reuse it unchanged. */
+static void mix_frame_into(int16_t *out, size_t out_n,
+                           const int16_t *fm_buf, size_t fm_frames,
+                           const int16_t *psg_buf, size_t psg_frames)
+{
+    for (size_t i = 0; i < out_n; i++) {
+        size_t si = out_n == psg_frames ? i : i * psg_frames / out_n;
+        int32_t p = (int32_t)psg_buf[si] / s_psg_vol_div;
+        int32_t l = p;
+        int32_t r = p;
+        if (fm_buf != NULL && fm_frames > 0) {
+            size_t fi = si * fm_frames / psg_frames;
+            l += (int32_t)fm_buf[fi * 2 + 0] / FM_VOL_DIV;
+            r += (int32_t)fm_buf[fi * 2 + 1] / FM_VOL_DIV;
+        }
+        if (l >  32767) l =  32767; else if (l < -32768) l = -32768;
+        if (r >  32767) r =  32767; else if (r < -32768) r = -32768;
+        out[i * 2 + 0] = (int16_t)l;
+        out[i * 2 + 1] = (int16_t)r;
+    }
+}
+
+/* ---- BOTH-mode per-chip export (diagnostic) ------------------------------
+ * GENESIS_AUDIO_CHIPDUMP=<prefix> writes <prefix>A.wav and <prefix>B.wav: the
+ * two virtual chips' own mixed streams, produced by exactly the same mix that
+ * feeds the main WAV. Used to prove chip A == MUSIC mode and chip B ==
+ * SOUND EFFECTS mode on the same deterministic route. No-op (and no extra
+ * work) unless the variable is set AND writer-routed dual-chip mixing is
+ * active for that frame. */
+static FILE *s_chip_wav[2];
+static uint32_t s_chip_bytes[2];
+static int s_chip_dump_looked;
+static const char *s_chip_dump_prefix;
+static int16_t s_chip_mix[OUT_BUF_FRAMES * 2];
+
+static void chip_dump_open(int chip)
+{
+    char path[1024];
+    if (!s_chip_dump_looked) {
+        s_chip_dump_looked = 1;
+        const char *p = getenv("GENESIS_AUDIO_CHIPDUMP");
+        if (p && *p) s_chip_dump_prefix = p;
+    }
+    if (!s_chip_dump_prefix || s_chip_wav[chip]) return;
+    snprintf(path, sizeof path, "%s%c.wav", s_chip_dump_prefix,
+             chip == 0 ? 'A' : 'B');
+    s_chip_wav[chip] = fopen(path, "wb");
+    if (!s_chip_wav[chip]) {
+        fprintf(stderr, "[audio] chip dump: cannot open %s\n", path);
+        return;
+    }
+    s_chip_bytes[chip] = 0;
+    wav_write_header(s_chip_wav[chip], 223721, 0);
+    fprintf(stderr, "[audio] chip dump started: %s\n", path);
+}
+
+static void chip_dump_stop(void)
+{
+    for (int chip = 0; chip < 2; chip++) {
+        if (!s_chip_wav[chip]) continue;
+        if (fseek(s_chip_wav[chip], 0, SEEK_SET))
+            fprintf(stderr, "[audio] chip dump: seek failed\n");
+        else
+            wav_write_header(s_chip_wav[chip], 223721, s_chip_bytes[chip]);
+        fclose(s_chip_wav[chip]);
+        s_chip_wav[chip] = NULL;
+    }
+}
+
+/* Write this frame's per-chip streams, if the export is active. */
+static void chip_dump_frame(void)
+{
+    if (!s_chip_dump_looked) {
+        s_chip_dump_looked = 1;
+        const char *p = getenv("GENESIS_AUDIO_CHIPDUMP");
+        if (p && *p) s_chip_dump_prefix = p;
+    }
+    if (!s_chip_dump_prefix) return;
+    for (int chip = 0; chip < 2; chip++) {
+        const int16_t *fm = NULL, *psg = NULL;
+        size_t fn = 0, pn = 0;
+        if (!audio_mixer_chip_output(chip, &fm, &fn, &psg, &pn) || pn == 0)
+            continue;
+        chip_dump_open(chip);
+        if (!s_chip_wav[chip]) continue;
+        if (pn > OUT_BUF_FRAMES) pn = OUT_BUF_FRAMES;
+        mix_frame_into(s_chip_mix, pn, fm, fn, psg, pn);
+        uint32_t bytes = (uint32_t)(pn * 2 * sizeof(int16_t));
+        fwrite(s_chip_mix, 1, bytes, s_chip_wav[chip]);
+        s_chip_bytes[chip] += bytes;
+    }
+}
+
 void audio_flush(uint32_t wall_frame, int realtime,
                  const int16_t *fm_buf,  size_t fm_frames,
                  const int16_t *psg_buf, size_t psg_frames)
@@ -377,28 +481,10 @@ void audio_flush(uint32_t wall_frame, int realtime,
      * This is now a FIXED ratio-1 conversion, never rate-modulated: the DRC
      * bridge owns the band-limited downsample to the device rate and the
      * clock-domain servo, so this mix never drops/duplicates a sample. */
-    #define MIX_INTO(out_n)                                                  \
-        for (size_t i = 0; i < (out_n); i++) {                               \
-            size_t si = (out_n) == psg_frames ? i                            \
-                        : i * psg_frames / (out_n);                          \
-            int32_t p = (int32_t)psg_buf[si] / s_psg_vol_div;                \
-            int32_t l = p;                                                   \
-            int32_t r = p;                                                   \
-            if (fm_buf != NULL && fm_frames > 0) {                           \
-                size_t fi = si * fm_frames / psg_frames;                     \
-                l += (int32_t)fm_buf[fi * 2 + 0] / FM_VOL_DIV;               \
-                r += (int32_t)fm_buf[fi * 2 + 1] / FM_VOL_DIV;               \
-            }                                                                \
-            if (l >  32767) l =  32767; else if (l < -32768) l = -32768;     \
-            if (r >  32767) r =  32767; else if (r < -32768) r = -32768;     \
-            s_out[i * 2 + 0] = (int16_t)l;                                   \
-            s_out[i * 2 + 1] = (int16_t)r;                                   \
-        }
-
     /* Mix one video frame at the internal PSG rate into s_out (PSG ratio 1; FM
      * upsampled to PSG rate). This is the single mix, a FIXED conversion, so it
      * no longer crackles. The DRC bridge owns the downsample and the servo. */
-    MIX_INTO(psg_frames);
+    mix_frame_into(s_out, psg_frames, fm_buf, fm_frames, psg_buf, psg_frames);
     if (s_extra_source)
         s_extra_source(s_out, psg_frames, s_mix_rate);
 
@@ -412,6 +498,7 @@ void audio_flush(uint32_t wall_frame, int realtime,
         else fwrite(s_out, 1, bytes, s_wav_file);
         s_wav_data_bytes += bytes;
     }
+    chip_dump_frame();
 
     /* Master volume — speaker output only (applied after the WAV tap, so paired
      * captures stay bit-deterministic regardless of this setting). */
@@ -540,6 +627,7 @@ int audio_wav_start(const char *path)
 
 void audio_wav_stop(void)
 {
+    chip_dump_stop();   /* same lifetime as the main capture */
     if (!s_wav_file) return;
     /* Drain immutable PCM before seeking back to finalize the RIFF header. */
     int ok = genesis_host_stream_destroy(s_wav_stream);
diff --git a/runner/audio/event_queue.c b/runner/audio/event_queue.c
index f22e787..ce4ca4c 100644
--- a/runner/audio/event_queue.c
+++ b/runner/audio/event_queue.c
@@ -20,6 +20,35 @@ static AudioEvent s_ring[QUEUE_CAP];
 static size_t     s_head = 0;  /* producer writes here */
 static size_t     s_tail = 0;  /* consumer reads here */
 static size_t     s_overflow_count = 0;
+
+/* Writer-routed second virtual chip (BOTH mode). Off by default: the stock
+ * single-chip path is untouched. */
+static int s_chip_routing_dual = 0;
+void audio_set_chip_routing(int dual) { s_chip_routing_dual = dual != 0; }
+int  audio_chip_routing_dual(void) { return s_chip_routing_dual; }
+
+/* First Z80 core's program, for the Music/SFX volume split (default: music,
+ * i.e. the resident music driver, so stock modes are unaffected). */
+static int s_first_z80_sfx = 0;
+void audio_set_first_z80_is_sfx(int is_sfx) { s_first_z80_sfx = is_sfx != 0; }
+int  audio_first_z80_is_sfx(void) { return s_first_z80_sfx; }
+int  audio_event_source_is_sfx(uint8_t origin)
+{
+    if (origin == AUDIO_ORIGIN_Z80) return s_first_z80_sfx;
+    return 1;   /* 68K FM/PSG engine, or the second core's race SFX PCM */
+}
+
+/* Second Z80 core (BOTH mode). Off by default. */
+static int s_second_z80 = 0;
+static AudioZ80RouteFn s_z80_route_fn = 0;
+void audio_second_z80_set_enabled(int on) { s_second_z80 = on != 0; }
+int  audio_second_z80_enabled(void) { return s_second_z80; }
+void audio_set_z80_route_fn(AudioZ80RouteFn fn) { s_z80_route_fn = fn; }
+int  audio_z80_route_to_second(int access, uint16_t off, uint8_t value)
+{
+    if (!s_second_z80 || !s_z80_route_fn) return 0;
+    return s_z80_route_fn(access, off, value) != 0;
+}
 size_t audio_event_state_size(void) { return sizeof(uint32_t)+sizeof s_ring; }
 size_t audio_event_rb_save(void *dst, size_t cap)
 {
@@ -122,6 +151,12 @@ int audio_event_cosim_hist(uint64_t *out_idx, uint32_t *out_stamp, uint32_t *out
 #endif /* GENESIS_COSIM */
 
 void audio_event_push(uint32_t cycle_stamp, uint8_t port, uint8_t value)
+{
+    audio_event_push_origin(cycle_stamp, port, value, AUDIO_ORIGIN_68K);
+}
+
+void audio_event_push_origin(uint32_t cycle_stamp, uint8_t port, uint8_t value,
+                             uint8_t origin)
 {
 #ifdef GENESIS_COSIM
     hist_record(cycle_stamp, port, value);
@@ -177,6 +212,7 @@ void audio_event_push(uint32_t cycle_stamp, uint8_t port, uint8_t value)
     s_ring[s_head].cycle_stamp = cycle_stamp;
     s_ring[s_head].port        = port;
     s_ring[s_head].value       = value;
+    s_ring[s_head].origin      = origin;
     s_head = next_head;
 }
 
diff --git a/runner/audio/event_queue.h b/runner/audio/event_queue.h
index 0615596..cb182d5 100644
--- a/runner/audio/event_queue.h
+++ b/runner/audio/event_queue.h
@@ -24,14 +24,73 @@ enum {
     AUDIO_PORT_PSG      = 4,   /* $C00011 write */
 };
 
+/* Which writer issued the chip write. The queue already carried only the
+ * writer PC for diagnostics; this is the same information as a field, so a
+ * second virtual chip can be fed by writer (BOTH mode). */
+enum {
+    AUDIO_ORIGIN_68K = 0,     /* 68K FM/PSG engine (or boot code)  */
+    AUDIO_ORIGIN_Z80 = 1,     /* resident Z80 driver (music)       */
+    AUDIO_ORIGIN_Z80_SFX = 2  /* second Z80 core: race SFX PCM     */
+};
+
 typedef struct AudioEvent {
     uint32_t cycle_stamp;   /* g_audio_cycle_counter at time of write */
     uint8_t  port;
     uint8_t  value;
-} AudioEvent;
+    uint8_t  origin;        /* AUDIO_ORIGIN_*                         */
+} AudioEvent;               /* still 8 bytes: 3 payload bytes + padding */
 
-/* Push one event. Safe to call from anywhere inside the game fiber. */
+/* Push one event. Safe to call from anywhere inside the game fiber.
+ * audio_event_push() is the 68K writer (the historical default); the Z80 bus
+ * push sites use audio_event_push_origin() with AUDIO_ORIGIN_Z80. */
 void audio_event_push(uint32_t cycle_stamp, uint8_t port, uint8_t value);
+void audio_event_push_origin(uint32_t cycle_stamp, uint8_t port, uint8_t value,
+                             uint8_t origin);
+
+/* Dual-chip routing (host audio option; default off). When on, the mixer
+ * feeds a second virtual YM2612+SN76489 from 68K-origin writes and the first
+ * chip from Z80-origin writes, so two drivers never share one register file.
+ * Off keeps the single-chip path exactly as it was. */
+void audio_set_chip_routing(int dual);
+int  audio_chip_routing_dual(void);
+
+/* Which program the FIRST Z80 core is running, for the separate Music/SFX
+ * volume split. The tag says *who wrote* (68K, first Z80, second Z80), not
+ * *what it plays*: in MUSIC and BOTH the first core holds the music driver,
+ * but the cartridge's race SFX PCM image is uploaded over it in stock SOUND
+ * EFFECTS mode, and then the first core's writes are sound effects. The game
+ * knows which image is resident and says so; the default (0 = music) leaves
+ * every stock path unchanged. The second core's writes are always SFX. */
+void audio_set_first_z80_is_sfx(int is_sfx);
+int  audio_first_z80_is_sfx(void);
+/* Source of one event for the volume split: 1 = sound effects, 0 = music. */
+int  audio_event_source_is_sfx(uint8_t origin);
+
+/* ---- Second Z80 core (BOTH mode, race SFX PCM image) --------------------
+ * A cartridge can need two different Z80 programs at once: the resident music
+ * driver and a small sample/PCM player. They cannot share one 8 KB RAM, so
+ * with dual-chip routing the machine runs a second Z80 core with its own RAM,
+ * bank register and bus-request/reset state. Off by default; stock modes never
+ * instantiate or step it. */
+void audio_second_z80_set_enabled(int on);
+int  audio_second_z80_enabled(void);
+
+/* 68K accesses to the Z80 address space normally belong to the canonical core
+ * (music driver). A game that uploads a second image tells the bus which of
+ * those accesses must go to the second core instead: its own upload routine
+ * (RAM writes + the reset/busreq lines) and its later command ports. The
+ * predicate is the game's; the engine only asks it on 68K Z80-space accesses
+ * while second-core mode is on, so the stock paths never pay for it. */
+enum {
+    AUDIO_Z80_ACCESS_RAM = 0,   /* $A00000-$A0FFFF write/read, off = RAM off */
+    AUDIO_Z80_ACCESS_BUSREQ = 1,/* $A11100 write/ack read                    */
+    AUDIO_Z80_ACCESS_RESET = 2  /* $A11200 reset line                       */
+};
+typedef int (*AudioZ80RouteFn)(int access, uint16_t off, uint8_t value);
+void audio_set_z80_route_fn(AudioZ80RouteFn fn);
+/* 1 = this 68K access targets the second core. Always 0 when the second core
+ * is disabled, so it is safe to call on the stock path. */
+int  audio_z80_route_to_second(int access, uint16_t off, uint8_t value);
 
 /* Drain iterator. Returns 1 if *out was filled, 0 if queue empty.
  * Call repeatedly until it returns 0 to walk the frame's events in order. */
