+/* A linear gain ramp across one frame's buffer. `from`/`to` are 256ths. The
+ * last sample carries exactly `to`, so the next frame is unmodified when it
+ * stays there. */
+static void mixer_gain_ramp(int16_t *buf, size_t samples, unsigned channels,
+                            int from, int to)
+{
+    if (!buf || !samples) return;
+    if (from == 256 && to == 256) return;   /* default: no arithmetic at all */
+    const int64_t span = samples > 1 ? (int64_t)samples - 1 : 1;
+    const int64_t base = (int64_t)from << 8;            /* q16 */
+    const int64_t delta = ((int64_t)to - from) << 8;
+    for (size_t i = 0; i < samples; ++i) {
+        int g = (int)(base + delta * (int64_t)i / span);
+        for (unsigned c = 0; c < channels; ++c) {
+            size_t p = i * channels + c;
+            buf[p] = (int16_t)(((int32_t)buf[p] * g) >> 16);
+        }
+    }
