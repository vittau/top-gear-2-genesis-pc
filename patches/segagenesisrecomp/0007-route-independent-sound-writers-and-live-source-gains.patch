+void audio_mixer_set_source_volumes(int music_pct, int sfx_pct)
+{
+    if (music_pct < 0) music_pct = 0; else if (music_pct > 100) music_pct = 100;
+    if (sfx_pct   < 0) sfx_pct   = 0; else if (sfx_pct   > 100) sfx_pct   = 100;
