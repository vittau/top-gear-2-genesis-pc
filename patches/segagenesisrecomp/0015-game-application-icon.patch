From c809e37e44b5a4537b70e0edde9e0cf60cdcc939 Mon Sep 17 00:00:00 2001
From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Date: Sat, 7 Nov 2026 01:37:34 -0300
Subject: [PATCH] Expose game-owned desktop identity and embedded window icon

---
 runner/game_spec.h |  9 +++++++++
 runner/main.c      | 19 +++++++++++++++++++
 2 files changed, 28 insertions(+)

diff --git a/runner/game_spec.h b/runner/game_spec.h
index 2176f1e..9d0c130 100644
--- a/runner/game_spec.h
+++ b/runner/game_spec.h
@@ -76,6 +76,15 @@ typedef struct GameSpec {
      * Hedgehog". Build/backend/debug identity belongs in logs and About. */
     const char *display_name;
     const char *short_name;          /* "Sonic1" — shows up in info / ping */
+    /* Optional desktop identity (basename of the .desktop file, no suffix).
+     * Set before any SDL video init, including the launcher. NULL preserves
+     * SDL's default. The environment may override it for host integration. */
+    const char *app_id;
+    /* Optional embedded RGBA8 icon, row-major, width*4 bytes per row. Immutable
+     * game-owned pixels; SDL copies them when the gameplay window is created.
+     * Native Wayland uses app_id + installed desktop metadata instead. */
+    const uint8_t *icon_rgba;
+    int icon_width, icon_height;
     /* Box-art file staged next to the exe under assets/img/, e.g.
      * "boxart-sonic3.tga". NULL => the shared "boxart.tga" (single-boxart
      * repos). Needed when several game modes build into ONE exe dir (the
diff --git a/runner/main.c b/runner/main.c
index fc1b7eb..089ebf7 100644
--- a/runner/main.c
+++ b/runner/main.c
@@ -2457,6 +2457,13 @@ static void macos_bundle_paths(void)
 
 int main(int argc, char *argv[])
 {
+    /* SDL2's Wayland app id and X11 resource class must agree with the
+     * desktop entry. Set these before the launcher can initialize video. */
+    if (g_game_spec.app_id && *g_game_spec.app_id) {
+        SDL_setenv("SDL_VIDEO_WAYLAND_WMCLASS", g_game_spec.app_id, 0);
+        SDL_setenv("SDL_VIDEO_X11_WMCLASS", g_game_spec.app_id, 0);
+        SDL_SetHintWithPriority("SDL_APP_ID", g_game_spec.app_id, SDL_HINT_DEFAULT);
+    }
     init_exe_dir(argv[0]);
 #ifdef __APPLE__
     macos_bundle_paths();
@@ -3087,6 +3094,18 @@ int main(int argc, char *argv[])
         fprintf(stderr, "SDL_CreateWindow: %s\n", SDL_GetError());
         return 1;
     }
+    if (g_game_spec.icon_rgba && g_game_spec.icon_width > 0 &&
+        g_game_spec.icon_width <= 1024 && g_game_spec.icon_height > 0 &&
+        g_game_spec.icon_height <= 1024) {
+        SDL_Surface *icon = SDL_CreateRGBSurfaceWithFormatFrom(
+            (void *)g_game_spec.icon_rgba, g_game_spec.icon_width,
+            g_game_spec.icon_height, 32, g_game_spec.icon_width * 4,
+            SDL_PIXELFORMAT_RGBA32);
+        if (icon) {
+            SDL_SetWindowIcon(window, icon);
+            SDL_FreeSurface(icon);
+        }
+    }
     fprintf(stderr, "[VIDEO] window %dx%d (%s)\n", win_w, win_h,
             (custom_video_on || ws_armed()) ? "16:9 widescreen" : "4:3");
 
-- 
