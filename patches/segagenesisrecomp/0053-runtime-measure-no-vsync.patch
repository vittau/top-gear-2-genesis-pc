From 0160e141d2e38348a6342634d80a7a477614609f Mon Sep 17 00:00:00 2001
From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Date: Tue, 10 Nov 2026 17:32:40 -0300
Subject: [PATCH] Keep uncapped runtime measurement free of VSync

Software SDL renderer info advertises VSync capability even without a request.
Do not restore that mode while --runtime-uncapped explicitly disables pacing;
ordinary gameplay retains its existing display-clock policy.
---
 runner/main.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/runner/main.c b/runner/main.c
index c1c70fa..bb95c70 100644
--- a/runner/main.c
+++ b/runner/main.c
@@ -5069,7 +5069,7 @@ session_begin:;
                     "the deadline pacer owns the guest clock\n",display_hz,target_fps);
             s_rate_lock_logged=1;
         }
-        int want_vsync=(high_refresh||rate_locked)?0:original_vsync;
+        int want_vsync=(runtime_uncapped||high_refresh||rate_locked)?0:original_vsync;
         if(want_vsync!=presentation_vsync) {
             if(SDL_RenderSetVSync(renderer,want_vsync)==0)presentation_vsync=want_vsync;
         }
