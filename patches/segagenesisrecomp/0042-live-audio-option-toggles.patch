+/* Same option surface as the in-game rows, without a menu: used by the
+ * input-script OPTION directive so an automated capture can toggle a player
+ * option at an exact frame. Returns 1 when the key was accepted. */
+int runner_options_set(const char *key, int value) {
+    if (!key || !*key) return 0;
+    if (!strcmp(key, RECOMP_RUNTIME_UI_KEY_VOLUME)) {
+        g_app_config.volume = value; audio_set_master_volume(value);
+    } else if (!g_game_spec.runtime_ui_set || !g_game_spec.runtime_ui_set(key, value)) {
+        return 0;
+    }
+    runtime_ui_save(NULL);
+    return 1;
+}
