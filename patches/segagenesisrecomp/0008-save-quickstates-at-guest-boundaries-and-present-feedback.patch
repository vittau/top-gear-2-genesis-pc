+    case '5': return OVL_GLYPH(31,16,16,30,1,1,30);
+    case '6': return OVL_GLYPH(14,16,16,30,17,17,14);
+    case '7': return OVL_GLYPH(31,1,2,4,8,8,8);
+    case '8': return OVL_GLYPH(14,17,17,14,17,17,14);
