+static void handle_pad(int id)
+{
+    extern int input_gameplay_blocked(void);
+    char buf[160];
+    snprintf(buf, sizeof buf,
+             "{\"id\":%d,\"ok\":true,\"pad0\":%d,\"pad1\":%d,\"blocked\":%d}",
+             id, runner_debug_pad_mask(0), runner_debug_pad_mask(1), input_gameplay_blocked());
+    send_response(buf);
+}
+
+static void handle_ui_rows(int id)
+{
+    int count = runner_debug_ui_row_count();
+    char buf[48 * 320 + 128], entry[384];
+    size_t pos = (size_t)snprintf(buf, sizeof buf,
+                                  "{\"id\":%d,\"ok\":true,\"rows\":[", id);
+    for (int i = 0; i < count; ++i) {
+        char label[96], value[96], label_json[200], value_json[200];
+        int selected = 0;
+        if (!runner_debug_ui_row(i, label, sizeof label, value, sizeof value, &selected))
+            break;
+        json_escape_copy(label_json, sizeof label_json, label);
+        json_escape_copy(value_json, sizeof value_json, value);
+        int len = snprintf(entry, sizeof entry,
+                           "%s{\"label\":\"%s\",\"value\":\"%s\",\"selected\":%s}",
+                           i ? "," : "", label_json, value_json, selected ? "true" : "false");
+        if (len < 0 || (size_t)len >= sizeof entry || pos + (size_t)len + 3 > sizeof buf)
+            break;
+        memcpy(buf + pos, entry, (size_t)len);
+        pos += (size_t)len;
+    }
+    memcpy(buf + pos, "]}", 3);
+    send_response(buf);
 }
 
