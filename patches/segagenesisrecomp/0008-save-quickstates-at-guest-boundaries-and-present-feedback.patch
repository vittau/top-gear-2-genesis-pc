+static void runner_state_notice_tick(void)
+{
+    if (s_state_notice_until && (Sint32)(SDL_GetTicks() - s_state_notice_until) >= 0) {
+        s_state_notice[0] = 0;
+        s_state_notice_until = 0;
+#if RECOMP_LAUNCHER
+        if (s_runtime_ui.window)
+            SDL_SetWindowTitle(s_runtime_ui.window, g_game_spec.display_name);
+#endif
+    }
