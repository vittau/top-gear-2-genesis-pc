From 011be69e36e6d8e17a7b4086e34681202c64b010 Mon Sep 17 00:00:00 2001
From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Date: Tue, 10 Nov 2026 12:43:13 -0300
Subject: [PATCH] Add opt-in runtime menu grouping and explicit section order

---
 runner/main.c | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/runner/main.c b/runner/main.c
index f231efe..c1c70fa 100644
--- a/runner/main.c
+++ b/runner/main.c
@@ -2145,7 +2145,8 @@ int runner_write_presented_screenshot_file(const char *path)
 
 /* Opt-in exact-frame capture of the SDL output, including scaling/bars.
  * Guest framebuffer screenshots retain their existing semantics. */
-static void capture_presented_window(SDL_Renderer *renderer, unsigned frame)
+static void capture_presented_window(SDL_Renderer *renderer, unsigned frame,
+                                     SDL_Texture *texture, const SDL_Rect *source)
 {
     const char *frames = getenv("GENESIS_WINDOW_CAPTURE_FRAMES");
     const char *prefix = getenv("GENESIS_WINDOW_CAPTURE_PREFIX");
@@ -2162,10 +2163,23 @@ static void capture_presented_window(SDL_Renderer *renderer, unsigned frame)
     if (!match) return;
     int w, h;
     SDL_Rect viewport;
+    int lw, lh, tw, th; float sx, sy; SDL_ScaleMode mode;
+    SDL_RenderGetLogicalSize(renderer, &lw, &lh);
+    SDL_RenderGetScale(renderer, &sx, &sy);
+    SDL_QueryTexture(texture, NULL, NULL, &tw, &th);
+    SDL_GetTextureScaleMode(texture, &mode);
+    SDL_RendererInfo info; SDL_GetRendererInfo(renderer, &info);
     SDL_GetRendererOutputSize(renderer, &w, &h);
     SDL_RenderGetViewport(renderer, &viewport);
     uint32_t *pixels = malloc((size_t)w * h * sizeof *pixels);
     if (!pixels) return;
+    char metadata[1024];
+    snprintf(metadata, sizeof metadata, "%s-%u.json", prefix, frame);
+    FILE *f = fopen(metadata, "w");
+    if (f) {
+        fprintf(f, "{\"frame\":%u,\"renderer\":\"%s\",\"output\":[%d,%d],\"logical\":[%d,%d],\"viewport\":[%d,%d,%d,%d],\"scale\":[%.9g,%.9g],\"texture\":[%d,%d],\"source\":[%d,%d,%d,%d],\"pitch_pixels\":%d,\"saved_filter\":%d,\"active_filter\":%d,\"sampler\":%d}\n", frame, info.name, w,h,lw,lh,viewport.x,viewport.y,viewport.w,viewport.h,sx,sy,tw,th,source->x,source->y,source->w,source->h,s_frame_stride,g_app_config.linear_filter,s_frame_texture_filtered,(int)mode);
+        fclose(f);
+    }
     SDL_RenderSetViewport(renderer, NULL);
     if (!SDL_RenderReadPixels(renderer, NULL, SDL_PIXELFORMAT_ARGB8888, pixels, w * 4)) {
         char path[1024];
@@ -5008,7 +5022,7 @@ session_begin:;
         if (frame_texture == texture)
             frame_texture = linear_picture(renderer, texture, present_src, s_frame_stride * 4, &src);
         SDL_RenderCopy(renderer, frame_texture, &src, NULL);
-        capture_presented_window(renderer, frame_num);
+        capture_presented_window(renderer, frame_num, frame_texture, &src);
 #if GENESIS_HAS_RECOMP_NET
         /* Process the peer INPUT and emit our CONFIRM before the blocking
          * present, so confirmation delivery overlaps vsync as well. */
-- 
