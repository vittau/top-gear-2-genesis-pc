diff --git a/runner/video/genesis_bus.c b/runner/video/genesis_bus.c
index c7d3a9c..ff6e90c 100644
--- a/runner/video/genesis_bus.c
+++ b/runner/video/genesis_bus.c
@@ -122,8 +122,18 @@ static void ym_write_side_effect(GenesisBus *b, uint8_t port, uint8_t val,
                 b->ym_timer_b_period =
                     (uint64_t)(256u - (unsigned)b->ym_timer_b) *
                     YM_TIMER_B_MASTER_TICK;
+            /* The load bit STARTS a stopped timer; it does not re-phase one
+             * that is already running. Hardware (and ymfm's own
+             * fm_engine_base::update_timer) only arms the counter on the
+             * 0 -> 1 transition, and the overflow flag is a level on a
+             * free-running grid: a driver that reloads the timer every tick
+             * therefore has its polling lateness repaid by the following
+             * shorter tick instead of accumulating. Re-arming the deadline on
+             * every write (the previous model) turned each late tick into
+             * permanent tempo loss. */
+            if (!b->ym_timer_b_running)
+                b->ym_timer_b_deadline = now + b->ym_timer_b_period;
             b->ym_timer_b_running = 1;
-            b->ym_timer_b_deadline = now + b->ym_timer_b_period;
         } else {
             b->ym_timer_b_running = 0;
         }
