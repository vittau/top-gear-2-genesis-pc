   view_fn = fn;
   initialized = 1;
   snprintf(folder, sizeof folder, "%s", directory);
+  /* The runner base directory is habitually passed with a trailing separator;
+   * strip it so joined paths never contain a doubled slash. */
+  {
+    size_t n = strlen(folder);
+    while (n && (folder[n - 1] == '/' || folder[n - 1] == '\\')) folder[--n] = '\0';
+    if (!n) { folder[0] = '.'; folder[1] = '\0'; }
+  }
   if (playback) {
     playing = 1;
     snprintf(path, sizeof path, "%s", playback);
