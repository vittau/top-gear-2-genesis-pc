@@ -317,15 +317,36 @@ void psg_reset_leftover_chip(int index)
 void psg_reset_leftover(void) { psg_reset_leftover_chip(0); }
 
 /* Save-state hooks (own-backend snapshots): the whole SN76489 register/
- * counter struct + sample-clock remainder. The output scratch is transient
- * (drained every frame) and is reset on load. */
+ * counter struct + sample-clock remainder. Chip 0's bytes are exactly the
+ * pre-BOTH format; chip 1 (the writer-routed BOTH-mode chip) follows as an
+ * OPTIONAL, tagged, length-prefixed trailer, so a quickstate written before
+ * BOTH existed still loads and leaves chip 1 alone. Chip 1 has to be in the
+ * file: its latch/volume/tone registers and LFSR phase are established by the
+ * driver that started an effect and are not re-sent by a driver resuming
+ * mid-effect. The output scratch is transient and is reset on load. */
 #include <stdio.h>
+enum {
+    PSG_CHIP1_TAG = 0x31535031,        /* "1PS1" little-endian */
+    PSG_CHIP1_VERSION = 1
+};
+
+static int psg_save_chip(int chip, FILE *f)
+{
+    if (!s_chips[chip].inited) psg_init_chip(chip);
+    if (fwrite(&s_chips[chip].sn, sizeof s_chips[chip].sn, 1, f) != 1) return 0;
+    if (fwrite(&s_chips[chip].leftover_master_cycles,
+               sizeof s_chips[chip].leftover_master_cycles, 1, f) != 1) return 0;
+    return 1;
+}
+
 int psg_save_state(FILE *f)
 {
     if (!s_chips[0].inited) psg_init();
-    if (fwrite(&s_chips[0].sn, sizeof s_chips[0].sn, 1, f) != 1) return 0;
-    if (fwrite(&s_chips[0].leftover_master_cycles, sizeof s_chips[0].leftover_master_cycles, 1, f) != 1) return 0;
-    return 1;
+    if (!psg_save_chip(0, f)) return 0;
+    uint32_t tag = PSG_CHIP1_TAG, version = PSG_CHIP1_VERSION;
+    if (fwrite(&tag, sizeof tag, 1, f) != 1) return 0;
+    if (fwrite(&version, sizeof version, 1, f) != 1) return 0;
+    return psg_save_chip(1, f);
 }
 
 #include "cosim.h"
@@ -370,50 +391,115 @@ int psg_cosim_dump(char *buf, int cap) {
 }
 #endif /* GENESIS_COSIM */
 
+/* Rollback snapshots carry both chips as well: rewinding inside BOTH must
+ * restore the effects chip instead of leaving it at the moment being rewound
+ * away from. Chip 0's layout is the historical one; chip 1 follows unchanged in
+ * the same shape, and a chip-0-only image still loads. */
+static size_t psg_rb_chip_size(int chip)
+{
+    if (!s_chips[chip].inited) psg_init_chip(chip);
+    uint32_t pend = (uint32_t)(s_chips[chip].scratch_write - s_chips[chip].scratch_read);
+    return sizeof s_chips[chip].sn + sizeof s_chips[chip].leftover_master_cycles +
+           sizeof pend + (size_t)pend * 2u * sizeof(int16_t);
+}
+
+static uint8_t *psg_rb_chip_save(int chip, uint8_t *o)
+{
+    if (!s_chips[chip].inited) psg_init_chip(chip);
+    uint32_t pend = (uint32_t)(s_chips[chip].scratch_write - s_chips[chip].scratch_read);
+    memcpy(o, &s_chips[chip].sn, sizeof s_chips[chip].sn); o += sizeof s_chips[chip].sn;
+    memcpy(o, &s_chips[chip].leftover_master_cycles, sizeof s_chips[chip].leftover_master_cycles);
+    o += sizeof s_chips[chip].leftover_master_cycles;
+    memcpy(o, &pend, sizeof pend); o += sizeof pend;
+    memcpy(o, &s_chips[chip].scratch[s_chips[chip].scratch_read], (size_t)pend * sizeof(int16_t));
+    o += (size_t)pend * sizeof(int16_t);
+    memcpy(o, &s_chips[chip].raw_scratch[s_chips[chip].scratch_read], (size_t)pend * sizeof(int16_t));
+    o += (size_t)pend * sizeof(int16_t);
+    return o;
+}
+
+static int psg_rb_chip_load(int chip, const uint8_t *i, size_t len)
+{
+    if (!s_chips[chip].inited) psg_init_chip(chip);
+    uint32_t pend = 0;
+    size_t fixed = sizeof s_chips[chip].sn + sizeof s_chips[chip].leftover_master_cycles + sizeof pend;
+    if (!i || len < fixed) return 0;
+    memcpy(&pend, i + sizeof s_chips[chip].sn + sizeof s_chips[chip].leftover_master_cycles, sizeof pend);
+    if (pend > PSG_SCRATCH_SAMPLES || len != fixed + (size_t)pend * 2u * sizeof(int16_t)) return 0;
+    memcpy(&s_chips[chip].sn, i, sizeof s_chips[chip].sn); i += sizeof s_chips[chip].sn;
+    memcpy(&s_chips[chip].leftover_master_cycles, i, sizeof s_chips[chip].leftover_master_cycles);
+    i += sizeof s_chips[chip].leftover_master_cycles + sizeof pend;
+    memcpy(s_chips[chip].scratch, i, (size_t)pend * sizeof(int16_t));
+    i += (size_t)pend * sizeof(int16_t);
+    memcpy(s_chips[chip].raw_scratch, i, (size_t)pend * sizeof(int16_t));
+    s_chips[chip].scratch_read = 0;
+    s_chips[chip].scratch_write = pend;
+    return 1;
+}
+
+/* Length of one chip's image inside a snapshot, derived from the image. */
+static int psg_rb_chip_span(const uint8_t *i, size_t len, size_t *span)
+{
+    uint32_t pend = 0;
+    const size_t fixed = sizeof s_chips[0].sn + sizeof s_chips[0].leftover_master_cycles + sizeof pend;
+    if (!i || len < fixed) return 0;
+    memcpy(&pend, i + sizeof s_chips[0].sn + sizeof s_chips[0].leftover_master_cycles, sizeof pend);
+    if (pend > PSG_SCRATCH_SAMPLES) return 0;
+    size_t total = fixed + (size_t)pend * 2u * sizeof(int16_t);
+    if (len < total) return 0;
+    *span = total;
+    return 1;
+}
+
 size_t psg_rb_save(void *dst, size_t cap)
 {
     if (!s_chips[0].inited) psg_init();
-    uint32_t pend = (uint32_t)(s_chips[0].scratch_write - s_chips[0].scratch_read);
-    size_t need = sizeof s_chips[0].sn + sizeof s_chips[0].leftover_master_cycles + sizeof pend +
-                  (size_t)pend * 2u * sizeof(int16_t);
+    size_t need = psg_rb_chip_size(0) + psg_rb_chip_size(1);
     if (!dst) return need;
     if (cap < need) return 0;
-    uint8_t *o = (uint8_t *)dst;
-    memcpy(o, &s_chips[0].sn, sizeof s_chips[0].sn); o += sizeof s_chips[0].sn;
-    memcpy(o, &s_chips[0].leftover_master_cycles, sizeof s_chips[0].leftover_master_cycles);
-    o += sizeof s_chips[0].leftover_master_cycles;
-    memcpy(o, &pend, sizeof pend); o += sizeof pend;
-    memcpy(o, &s_chips[0].scratch[s_chips[0].scratch_read], (size_t)pend * sizeof(int16_t));
-    o += (size_t)pend * sizeof(int16_t);
-    memcpy(o, &s_chips[0].raw_scratch[s_chips[0].scratch_read], (size_t)pend * sizeof(int16_t));
+    uint8_t *o = psg_rb_chip_save(0, (uint8_t *)dst);
+    psg_rb_chip_save(1, o);
     return need;
 }
 
 int psg_rb_load(const void *src, size_t len)
 {
+    if (!src) return 0;
     if (!s_chips[0].inited) psg_init();
-    const uint8_t *i = (const uint8_t *)src;
-    uint32_t pend = 0;
-    size_t fixed = sizeof s_chips[0].sn + sizeof s_chips[0].leftover_master_cycles + sizeof pend;
-    if (!src || len < fixed) return 0;
-    memcpy(&pend, i + sizeof s_chips[0].sn + sizeof s_chips[0].leftover_master_cycles, sizeof pend);
-    if (pend > PSG_SCRATCH_SAMPLES || len != fixed + (size_t)pend * 2u * sizeof(int16_t)) return 0;
-    memcpy(&s_chips[0].sn, i, sizeof s_chips[0].sn); i += sizeof s_chips[0].sn;
-    memcpy(&s_chips[0].leftover_master_cycles, i, sizeof s_chips[0].leftover_master_cycles);
-    i += sizeof s_chips[0].leftover_master_cycles + sizeof pend;
-    memcpy(s_chips[0].scratch, i, (size_t)pend * sizeof(int16_t));
-    i += (size_t)pend * sizeof(int16_t);
-    memcpy(s_chips[0].raw_scratch, i, (size_t)pend * sizeof(int16_t));
-    s_chips[0].scratch_read = 0;
-    s_chips[0].scratch_write = pend;
+    size_t first = 0, second = 0;
+    if (!psg_rb_chip_span((const uint8_t *)src, len, &first)) return 0;
+    int both = first < len && psg_rb_chip_span((const uint8_t *)src + first, len - first, &second)
+               && first + second == len;
+    if (first != len && !both) return 0;
+    if (!psg_rb_chip_load(0, (const uint8_t *)src, first)) return 0;
+    if (!both) return 1;    /* chip-0-only image: leave chip 1 as it is */
+    return psg_rb_chip_load(1, (const uint8_t *)src + first, second);
+}
+
+static int psg_load_chip(int chip, FILE *f)
+{
+    if (!s_chips[chip].inited) psg_init_chip(chip);
+    if (fread(&s_chips[chip].sn, sizeof s_chips[chip].sn, 1, f) != 1) return 0;
+    if (fread(&s_chips[chip].leftover_master_cycles,
+              sizeof s_chips[chip].leftover_master_cycles, 1, f) != 1) return 0;
+    s_chips[chip].scratch_read = s_chips[chip].scratch_write = 0;
     return 1;
 }
 
 int psg_load_state(FILE *f)
 {
     if (!s_chips[0].inited) psg_init();
-    if (fread(&s_chips[0].sn, sizeof s_chips[0].sn, 1, f) != 1) return 0;
-    if (fread(&s_chips[0].leftover_master_cycles, sizeof s_chips[0].leftover_master_cycles, 1, f) != 1) return 0;
-    s_chips[0].scratch_read = s_chips[0].scratch_write = 0;
-    return 1;
+    if (!psg_load_chip(0, f)) return 0;
+    /* Optional chip-1 trailer; absent in a state written before BOTH existed
+     * (or when the next container section follows instead of the tag). */
+    long at = ftell(f);
+    uint32_t tag = 0;
+    if (at < 0 || fread(&tag, sizeof tag, 1, f) != 1 || tag != PSG_CHIP1_TAG) {
+        if (at >= 0) fseek(f, at, SEEK_SET);
+        return 1;
+    }
+    uint32_t version = 0;
+    if (fread(&version, sizeof version, 1, f) != 1 || version != PSG_CHIP1_VERSION)
+        return 0;
+    return psg_load_chip(1, f);
 }
