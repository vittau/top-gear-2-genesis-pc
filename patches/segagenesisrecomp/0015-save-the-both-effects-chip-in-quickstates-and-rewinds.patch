  * ymfm_saved_state (size-prefixed blob; the size is whatever the vendored
  * ymfm version serializes -- the format is private to a build), plus this
  * wrapper's sample-clock remainder and output-LPF state. The output scratch
- * ring is transient (drained every frame) and is reset on load. Only the
- * canonical chip 0 is in the state format; the second chip is re-synced from
- * the next frame of 68K writes after a load. */
-extern "C" int ym2612_save_state(FILE *f) {
-    if (!s_chips[0].inited) ym2612_init();
+ * ring is transient (drained every frame) and is reset on load.
+ *
+ * Chip 0's bytes are exactly the pre-BOTH format. Chip 1 (the writer-routed
+ * second chip) follows as an OPTIONAL, tagged, length-prefixed trailer, so a
+ * quickstate written before BOTH existed still loads and simply leaves chip 1
+ * alone -- the behaviour it had. Chip 1 has to be in the file: its key-on,
+ * envelope, pan and DAC state is established once by the engine that started
+ * an effect, and a driver that resumes mid-effect only streams data or
+ * frequency writes, so it cannot rebuild it. A quickstate without it reloaded a
+ * running race with an idle effects chip -- the engine sound (and every
+ * sustained FM voice) stayed silent while one-shot effects still keyed.
+ * The same applies to a rewind inside BOTH: see ym2612_rb_save(). */
+enum {
+    YM_CHIP1_TAG = 0x314D5931,          /* "1YM1" little-endian */
+    YM_CHIP1_VERSION = 1
+};
+
+static int save_chip(YmChip &c, FILE *f) {
+    if (!c.inited) ym2612_init_chip(c.index);
     std::vector<uint8_t> buf;
     ymfm::ymfm_saved_state st(buf, true);
-    s_chips[0].chip->save_restore(st);
+    c.chip->save_restore(st);
     uint32_t n = (uint32_t)buf.size();
     if (fwrite(&n, sizeof n, 1, f) != 1) return 0;
     if (n && fwrite(buf.data(), 1, n, f) != n) return 0;
-    if (fwrite(&s_chips[0].master_accum, sizeof s_chips[0].master_accum, 1, f) != 1) return 0;
-    if (fwrite(s_chips[0].lpf_prev, sizeof s_chips[0].lpf_prev, 1, f) != 1) return 0;
-    if (fwrite(s_chips[0].lpf_out,  sizeof s_chips[0].lpf_out,  1, f) != 1) return 0;
+    if (fwrite(&c.master_accum, sizeof c.master_accum, 1, f) != 1) return 0;
+    if (fwrite(c.lpf_prev, sizeof c.lpf_prev, 1, f) != 1) return 0;
+    if (fwrite(c.lpf_out,  sizeof c.lpf_out,  1, f) != 1) return 0;
+    return 1;
+}
+
+static int load_chip(YmChip &c, FILE *f) {
+    if (!c.inited) ym2612_init_chip(c.index);
+    uint32_t n = 0;
+    if (fread(&n, sizeof n, 1, f) != 1 || n > (1u << 20)) return 0;
+    std::vector<uint8_t> buf(n);
+    if (n && fread(buf.data(), 1, n, f) != n) return 0;
+    ymfm::ymfm_saved_state st(buf, false);
+    c.chip->save_restore(st);
+    if (fread(&c.master_accum, sizeof c.master_accum, 1, f) != 1) return 0;
+    if (fread(c.lpf_prev, sizeof c.lpf_prev, 1, f) != 1) return 0;
+    if (fread(c.lpf_out,  sizeof c.lpf_out,  1, f) != 1) return 0;
+    c.scratch_read = c.scratch_write = 0;
     return 1;
 }
 
+extern "C" int ym2612_save_state(FILE *f) {
+    if (!s_chips[0].inited) ym2612_init();
+    if (!save_chip(s_chips[0], f)) return 0;
+    uint32_t tag = YM_CHIP1_TAG, version = YM_CHIP1_VERSION;
+    if (fwrite(&tag, sizeof tag, 1, f) != 1) return 0;
+    if (fwrite(&version, sizeof version, 1, f) != 1) return 0;
+    return save_chip(s_chips[1], f);
+}
