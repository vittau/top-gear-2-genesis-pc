From 73e6d665ea5fc013077b3eddd33f82cc7e9b7ff6 Mon Sep 17 00:00:00 2001
From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Date: Thu, 12 Nov 2026 10:52:19 -0300
Subject: [PATCH] Stabilize device drift and chip sample clocks

Preserve chip clock remainders and timer phase while correcting device drift without modulating music tempo.
---
 runner/audio.c             |  75 +++++++++++++--
 runner/audio.h             |   7 ++
 runner/audio/mixer.c       |  18 ++--
 runner/recomp_audio_drc.h  | 191 ++++++++++++++++++++++++++++++-------
 runner/sim_step.c          |  12 ++-
 runner/video/genesis_bus.c |  12 ++-
 6 files changed, 262 insertions(+), 53 deletions(-)

diff --git a/runner/audio.c b/runner/audio.c
index ef618a4..1e9a5f3 100644
--- a/runner/audio.c
+++ b/runner/audio.c
@@ -185,12 +185,56 @@ int audio_init(int psg_sample_rate)
     cfg.channels    = 2;
     cfg.source_rate = (double)psg_sample_rate; /* internal FM+PSG mix rate */
     cfg.host_rate   = (double)got.freq;         /* device rate (48 kHz) */
-    /* Phase-1 stall concealment: a ~200 ms boot pre-roll hides the cold-start
-     * hitch for free (the servo drains the excess down to target over time),
-     * and stretch_enable (default 1) conceals brief producer stalls by a
-     * pitch-preserving loop of recent audio instead of fading to silence. */
-    cfg.preroll_ms     = 200.0;
+    /* Phase-1 stall concealment: boot pre-roll hides the cold-start hitch for
+     * free (it is discarded at prime, not resampled away), and stretch_enable
+     * (default 1) conceals a brief producer stall by a pitch-preserving loop of
+     * recent audio instead of fading to silence. */
+    cfg.preroll_ms     = 250.0;
     cfg.stretch_enable = 1;     /* conceal on (defaults to 1; pinned explicit) */
+    /* Steady-state ring target. Production arrives one video frame at a time
+     * (~16.7 ms of audio per push) while the device consumes continuously, so
+     * the instantaneous fill is a sawtooth of that amplitude. A 50 ms target
+     * made that sawtooth +/-33 % of the target and the servo chased it (the
+     * correction oscillated over its whole range at the beat frequency between
+     * the push rate and the callback rate) - audible as tempo/pitch wobble.
+     * 80 ms then kept the sawtooth at +/-21 %, but real-device measurement
+     * showed one 30 ms host hitch still took the cushion from ~60 ms down to
+     * 23 ms, so the target is 100 ms: two 50 ms hitches are absorbed without
+     * the ring ever running dry, and the added latency stays around 100 ms. */
+    cfg.target_ms      = 100.0;
+    cfg.ring_ms        = 250.0;
+    /* Steady-state tempo stability (task 18). The device crystal offset is a
+     * constant ratio; host jitter is not. The steady path is an integral
+     * estimator with a 2 s error low-pass and a 50 ppm/s slew, so the playback
+     * ratio is constant in the short term (no audible speed changes) and equals
+     * the device's real clock offset. A fill excursion beyond 40 ms (through a
+     * 200 ms low-pass, so the 16.7 ms push sawtooth cannot trigger it) is a
+     * hitch, not a clock: the same integrator then runs with a 1 %/s slew and
+     * refills the ring in a few hundred ms, which is inaudible against the
+     * hitch itself. */
+    cfg.err_lp_ms      = 200.0;     /* hitch detection */
+    cfg.err_slow_ms    = 2000.0;    /* steady-state clock estimate */
+    cfg.ki_per_s       = 0.02;
+    cfg.slew_steady_pp_per_s = 0.005;   /* 50 ppm/s: below audibility */
+    cfg.rescue_ms      = 40.0;      /* far outside the fill sawtooth */
+    cfg.deadband_ms    = 3.0;
+    cfg.slew_pp_per_s  = 1.0;       /* rescue path only */
+    /* Sustained pitch/tempo bound: +/-0.5 % = 8.6 cents, the width a real
+     * device crystal needs. The runner keeps the guest clock exact (no display
+     * quantisation, frame_pacer.h) and discards the boot pre-roll at prime, so
+     * the servo has nothing else to absorb; measured device/guest offsets on
+     * real hardware reach ~0.1 % and the loop is inaudible. A *transient* swing
+     * to this bound after a host hitch is what lets the servo refill the ring
+     * quickly; a *sustained* one cannot happen because the ring's latency
+     * bound would splice the surplus out first. */
+    cfg.max_correction = 0.005;
+    /* Hard latency bound: the fill is never allowed to stand more than
+     * target+60 ms above the read cursor. Under a host that really cannot keep
+     * up (a stall longer than the cushion, repeated), the surplus is spliced
+     * out behind a 4 ms gain dip once per episode instead of accumulating
+     * until the ring caps and drops samples one by one - the old behaviour was
+     * a growing delay that ended in a burst of clicks. */
+    cfg.overfull_ms    = 60.0;
     if (rab_init(&s_bridge, &cfg) != 0) {
         fprintf(stderr, "audio: rab_init (DRC bridge) failed\n");
         SDL_CloseAudioDevice(s_dev); s_dev = 0;
@@ -205,12 +249,15 @@ int audio_init(int psg_sample_rate)
     s_stats.min_queued_bytes = UINT32_MAX;  /* low-water: nothing sampled yet */
 
     /* No manual silence prime: the bridge holds output muted until its ring
-     * reaches the pre-roll fill, then fades in (clean startup, no edge click). */
+     * reaches the pre-roll fill, then fades in (clean startup, no edge click);
+     * the pre-roll excess is discarded at that moment, not resampled away. */
     SDL_PauseAudioDevice(s_dev, 0);
     fprintf(stderr, "[audio] DRC bridge: %d Hz internal -> %d Hz device "
-            "(preroll %.0f ms, conceal %s)\n",
-            psg_sample_rate, got.freq, cfg.preroll_ms,
-            cfg.stretch_enable ? "on" : "off");
+            "(preroll %.0f ms -> target %.0f ms, conceal %s, max correction %.2f%%, "
+            "ring %.0f ms, latency bound %.0f ms)\n",
+            psg_sample_rate, got.freq, cfg.preroll_ms, cfg.target_ms,
+            cfg.stretch_enable ? "on" : "off", cfg.max_correction * 100.0,
+            cfg.ring_ms, cfg.target_ms + cfg.overfull_ms);
     return 0;
 }
 
@@ -244,7 +291,8 @@ void audio_close(void)
                 1e6 * (double)s_publish_max_ticks / s_perf_freq,
                 blocks ? 1e6 * (double)s_exclusion_ticks / s_perf_freq / blocks : 0);
         fprintf(stderr, "[audio callback ownership] callbacks=%llu callback_peak_us=%llu "
-                "wait_peak_us=%llu conceals=%llu repeated=%llu underruns=%llu overflows=%llu fill_us=%llu\n",
+                "wait_peak_us=%llu conceals=%llu repeated=%llu underruns=%llu overflows=%llu "
+                "drains=%llu drained_frames=%llu prime_skipped=%llu fill_us=%llu\n",
                 (unsigned long long)s_trace_callbacks,
                 (unsigned long long)s_trace_callback_peak_us,
                 (unsigned long long)s_trace_wait_peak_us,
@@ -252,6 +300,9 @@ void audio_close(void)
                 (unsigned long long)s_trace_repeated,
                 (unsigned long long)s_trace_underruns,
                 (unsigned long long)s_trace_overflows,
+                (unsigned long long)s_bridge.stats.drain_events,
+                (unsigned long long)s_bridge.stats.drain_skipped_frames,
+                (unsigned long long)s_bridge.stats.prime_skipped_frames,
                 (unsigned long long)s_trace_final_fill_us);
     }
 }
@@ -388,7 +439,11 @@ void audio_flush(uint32_t wall_frame, int realtime,
         s_callback_peak_us = 0;
         s_host_timing.conceal_events = s_bridge.stats.stretch_events;
         s_host_timing.concealed_frames = s_bridge.stats.stretch_frames;
+        s_host_timing.underrun_events = s_bridge.stats.underrun_events;
+        s_host_timing.pushed_frames = bst.pushed_frames;
+        s_host_timing.pulled_frames = bst.pulled_frames;
         s_host_timing.fill_us = (uint32_t)(rab_fill_ms(&s_bridge) * 1000.0);
+        s_host_timing.corr_ppm = (int32_t)llround(s_bridge.stats.last_correction * 1e6);
         if (s_playback_enabled) {
             Uint64 publish_begin = s_buffer_trace ? SDL_GetPerformanceCounter() : 0;
             int prepared = rab_try_push_prepared(&s_bridge, s_prepared, (int)psg_frames);
diff --git a/runner/audio.h b/runner/audio.h
index 2b364c8..649812d 100644
--- a/runner/audio.h
+++ b/runner/audio.h
@@ -88,9 +88,16 @@ void audio_get_bridge_counts(uint64_t *pushed, uint64_t *overflow_drops);
 typedef struct {
     uint64_t conceal_events;
     uint64_t concealed_frames;
+    uint64_t underrun_events;
+    uint64_t pushed_frames;   /* source frames handed to the bridge */
+    uint64_t pulled_frames;   /* device frames delivered to the speaker */
     uint32_t lock_us;
