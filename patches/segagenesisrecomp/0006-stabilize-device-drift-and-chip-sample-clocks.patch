 } rab_bridge;
 
@@ -173,9 +202,14 @@ void rab_config_defaults(rab_config *c) {
     c->max_correction = 0.005;
     c->err_lp_ms      = 75.0;
     c->slew_pp_per_s  = 0.75;
+    c->err_slow_ms    = 2000.0;
+    c->ki_per_s       = 0.02;
+    c->slew_steady_pp_per_s = 0.05;
+    c->rescue_ms      = 40.0;
