     if ((e = getenv("GENESIS_MIXER_NO_SPREAD"))    && *e && *e!='0') s_no_spread   = 1;
     if ((e = getenv("GENESIS_MIXER_NO_PAIRGUARD")) && *e && *e!='0') s_no_pairguard= 1;
-    if ((e = getenv("GENESIS_MIXER_NO_LEFTOVER"))  && *e && *e!='0') s_no_leftover = 1;
+    if ((e = getenv("GENESIS_MIXER_RESET_LEFTOVER")) && *e && *e!='0') s_no_leftover = 1;
     if ((e = getenv("GENESIS_MIXER_NO_CLAMP"))     && *e && *e!='0') s_no_clamp    = 1;
     if (s_no_spread||s_no_pairguard||s_no_leftover||s_no_clamp)
         fprintf(stderr, "[MIXER-TOGGLE] no_spread=%d no_pairguard=%d no_leftover=%d no_clamp=%d\n",
@@ -322,12 +322,16 @@ void audio_mixer_drain(uint32_t frame_end_cycle,
     }
     if (frame_end_cycle > psg_prev) psg_advance (frame_end_cycle - psg_prev);
 
-    /* Match clownmdemu's per-Iterate sync-state reset: the sub-sample
-     * fractional cycle carried across is discarded at each frame
-     * boundary there (sync.psg.current_cycle is a per-Iterate local
-     * that resets to 0). Our persistent leftover caused sub-sample
-     * drift that may have been the boop source on long runs. */
-    if (!s_no_leftover) psg_reset_leftover();
+    /* Sub-sample clock remainder. This used to be discarded at every frame
+     * boundary (to mirror clownmdemu's per-Iterate sync reset); that loses up
+     * to 239 of the 240 master cycles in the PSG's sample divider on every
+     * frame, i.e. a systematic -112 ppm on top of the frame-length error, and
+     * it is why the offline tap was 3732 samples/frame instead of 3733.5.
+     * The remainder is kept now so the audio sample clock is the guest clock
+     * exactly (task 18 tempo fidelity); 3733/3734 samples alternate and the
+     * long-run average is exact. GENESIS_MIXER_RESET_LEFTOVER=1 restores the
+     * old per-frame reset for A/B measurement only. */
+    if (s_no_leftover) psg_reset_leftover();
 
     /* Copy generated samples into the caller's buffers. */
     size_t fm_avail  = ym2612_samples_available();
diff --git a/runner/recomp_audio_drc.h b/runner/recomp_audio_drc.h
index 0340757..bd6daff 100644
--- a/runner/recomp_audio_drc.h
+++ b/runner/recomp_audio_drc.h
@@ -45,9 +45,28 @@ typedef struct {
     double max_correction;  /* clamp on ratio correction (default 0.005)       */
     double err_lp_ms;       /* error low-pass time constant ms (default 75)    */
     double slew_pp_per_s;   /* correction slew, percent-points/sec (default 0.75) */
+    /* Steady-state tempo stability. The device crystal offset is a *constant*
+     * ratio (tens to hundreds of ppm); host jitter is not. The steady path is
+     * therefore an integral estimator with a long time constant: it converges
+     * to the offset and then holds it, while fill jitter cannot modulate the
+     * playback ratio (which would be heard as music speed/pitch wobble).
+     * `err_slow_ms` is the steady error low-pass, `ki_per_s` the integral gain
+     * (per second), `slew_steady_pp_per_s` the audible-limit slew, and
+     * `rescue_ms` the fill excursion above which the fast proportional path
+     * and `slew_pp_per_s` take over so a hitch is still absorbed quickly. */
+    double err_slow_ms;     /* steady-state error low-pass (default 2000)      */
+    double ki_per_s;        /* steady-state integral gain (default 0.02)       */
+    double slew_steady_pp_per_s; /* steady slew limit (default 0.05)           */
+    double rescue_ms;       /* fill excursion that enables the fast path (25)  */
     double deadband_ms;     /* +/- band around target with no correction (1.0)  */
     double em_low_ms;       /* below this = underrun emergency (default 12)     */
     double em_high_ms;      /* above this = overflow emergency (default 105)    */
+    /* Latency bound. The fill may sit `target_ms` above the read cursor in
+     * steady state, but never more than `overfull_ms` above target: beyond that
+     * the bridge splices the surplus out behind a 4 ms gain dip instead of
+     * letting the ring overflow (a hard drop is a click, and the ring silently
+     * hitting its cap is what turns one long frame into permanent latency). */
+    double overfull_ms;     /* surplus above target allowed before a drain (60) */
     /* --- Phase-1 stall concealment (brief transition/startup producer stalls) --- */
     double preroll_ms;      /* initial prime cushion; 0 => prime at target_ms.      *
                              * A boot pre-roll hides the cold-start hitch for free   *
@@ -67,6 +86,9 @@ typedef struct {
     uint64_t overflow_drops;    /* source frames dropped on ring overflow     */
     uint64_t stretch_frames;    /* output frames synthesized by stall conceal */
     uint64_t stretch_events;    /* distinct stall episodes concealed          */
+    uint64_t prime_skipped_frames; /* pre-roll excess discarded at prime      */
+    uint64_t drain_events;      /* latency-bound splices                      */
+    uint64_t drain_skipped_frames; /* source frames spliced out                */
     double   last_fill_ms;
     double   last_correction;   /* applied ratio correction (signed)          */
 } rab_stats;
@@ -84,8 +106,10 @@ typedef struct rab_bridge {
 
