     uint32_t fill_us;
+    /* Current DRC ratio correction in parts per million (signed). Real-time
+     * delivery only; a nonzero value means the speaker stream is being
+     * resampled away from the stock tempo by that much. */
+    int32_t  corr_ppm;
 } AudioHostTiming;
 void audio_get_host_timing(AudioHostTiming *out);
 uint32_t audio_queued_bytes(void);
