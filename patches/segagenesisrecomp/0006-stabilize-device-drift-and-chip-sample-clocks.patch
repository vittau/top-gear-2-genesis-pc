@@ -99,6 +123,11 @@ typedef struct rab_bridge {
     double loop_len;        /* looped region length in source frames           */
     double loop_pos;        /* fractional read cursor within the looped region */
 
+    /* latency bound: splice the surplus out behind a short gain dip */
+    int      drain_state;   /* 0 idle, 1 fading out, 2 fading in                */
+    uint32_t drain_left;    /* output frames left in the current fade half      */
+    double   drain_skip;    /* source frames to skip at the dip                 */
+
