             g_game_spec.expected_rom_crc32, g_game_spec.expected_rom_size,
             detected_rom, sizeof detected_rom);
@@ -2749,6 +2848,7 @@ int main(int argc, char *argv[])
         SDL_free(base);
         if (found) {
             rom_path = detected_rom;
+            rom_detected = 1;
             fprintf(stderr, "[ROM] found matching cartridge: %s\n", rom_path);
         } else {
             fprintf(stderr, "[ROM] No matching %s cartridge found (CRC32 %08X). "
@@ -2966,6 +3066,16 @@ int main(int argc, char *argv[])
 #endif
         if(!genesis_replay_mods(p,replay_path)) {fprintf(stderr,"[feedback-replay] cannot restore recorded mods\n");return 1;}
     }
+    /* A cartridge picked in the launcher (or remembered from a pick) moves
+     * into the library; one found by the search or named on the command line
+     * stays where it is. */
+    if (s_rom_library && !rom_from_cli && !rom_detected && g_game_spec.expected_rom_crc32) {
+        const char *library_rom = import_rom_into_library(rom_path, rom_raw, rom_raw_len);
+        if (library_rom != rom_path) {
+            rom_path = library_rom;
+            rom_cfg_write(rom_cfg_path, rom_path);
+        }
+    }
     uint32_t replay_rom_crc=rom_crc32(rom_raw,rom_raw_len);
     /* --- Load input script (if requested) before the SDL window opens
      * so any parse error fails fast without a flash of black window. */
@@ -3064,6 +3174,9 @@ int main(int argc, char *argv[])
         fprintf(stderr, "SDL_CreateWindow: %s\n", SDL_GetError());
         return 1;
     }
+#ifndef __APPLE__
+    /* SDL's Cocoa backend assigns NSApp.applicationIconImage here. The
+     * embedded cross-platform 32px window icon must not replace bundle ICNS. */
     if (g_game_spec.icon_rgba && g_game_spec.icon_width > 0 &&
         g_game_spec.icon_width <= 1024 && g_game_spec.icon_height > 0 &&
         g_game_spec.icon_height <= 1024) {
@@ -3076,6 +3189,7 @@ int main(int argc, char *argv[])
             SDL_FreeSurface(icon);
         }
     }
+#endif
     fprintf(stderr, "[VIDEO] window %dx%d (%s)\n", win_w, win_h,
             (custom_video_on || ws_armed()) ? "16:9 widescreen" : "4:3");
 
