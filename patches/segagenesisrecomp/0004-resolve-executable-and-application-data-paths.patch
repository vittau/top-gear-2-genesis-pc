         if(!path_is_absolute(user_dir) || strlen(user_dir)>sizeof s_data_dir-2) {
@@ -2734,12 +2828,17 @@ int main(int argc, char *argv[])
      * s_exe_dir also names the external AppImage directory, when applicable;
