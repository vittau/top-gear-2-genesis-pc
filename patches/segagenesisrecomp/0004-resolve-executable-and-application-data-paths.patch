 }
 
+#ifdef __APPLE__
+/* A double-clicked TG2Recomp.app runs from X.app/Contents/MacOS. Anchor the
+ * cartridge search and user data on the folder the player actually sees (the
+ * one containing X.app), and fall back to Application Support when the app
+ * sits in a read-only location such as /Applications. Assets are unaffected:
+ * SDL_GetBasePath() already reports Contents/Resources for a bundle. */
+static void macos_bundle_paths(void)
+{
+    char exe_dir[sizeof s_exe_dir];
+    char parent[sizeof s_exe_dir];
+    char data_dir[sizeof s_data_dir];
+    if (!genesis_macos_executable_dir(exe_dir, sizeof exe_dir)) return;
+    snprintf(s_exe_dir, sizeof s_exe_dir, "%s", exe_dir);
+    if (!genesis_macos_bundle_parent(exe_dir, parent, sizeof parent)) return;
+    snprintf(s_exe_dir, sizeof s_exe_dir, "%s", parent);
+    if (genesis_macos_is_installed_location(parent) &&
+        genesis_macos_app_support(data_dir, sizeof data_dir)) {
+        snprintf(s_data_dir, sizeof s_data_dir, "%s", data_dir);
+        s_rom_library = 1;
+        fprintf(stderr, "[paths] installed app; user data and cartridge: %s\n", s_data_dir);
+    } else if (genesis_path_is_writable(parent)) {
+        snprintf(s_data_dir, sizeof s_data_dir, "%s", parent);
+    } else if (genesis_macos_app_support(data_dir, sizeof data_dir)) {
+        snprintf(s_data_dir, sizeof s_data_dir, "%s", data_dir);
+        s_rom_library = 1;
+        fprintf(stderr, "[paths] bundle folder is read-only; user data: %s\n", s_data_dir);
+    }
+}
+#endif
+
+/* Copy a picked cartridge into the user data folder, so later launches find
+ * it there without the player keeping the original or picking it again.
+ * Only used when that folder is separate from the one beside the app (a
+ * macOS app in Applications or a read-only folder). The caller has already
+ * checked the cartridge identity. Returns the path to boot from. */
+static const char *import_rom_into_library(const char *rom_path,
+                                           const uint8_t *data, size_t size)
+{
+    static char imported[1024];
+    const char *name = rom_path;
+    const char *s1 = strrchr(rom_path, '/');
+    const char *s2 = strrchr(rom_path, '\\');
+    const char *sep = (s1 && s2) ? (s1 > s2 ? s1 : s2) : (s1 ? s1 : s2);
+    if (sep) name = sep + 1;
+    if (!*name) return rom_path;
+    int n = snprintf(imported, sizeof imported, "%s%s", s_data_dir, name);
+    if (n < 0 || (size_t)n >= sizeof imported) return rom_path;
+    if (strcmp(imported, rom_path) == 0) return rom_path;
+    if (genesis_rom_matches_file(imported, g_game_spec.expected_rom_crc32,
+                                 g_game_spec.expected_rom_size))
+        return imported;   /* already imported */
+    FILE *probe = fopen(imported, "rb");
+    if (probe) {
+        /* A different file already has this name; leave both alone. */
+        fclose(probe);
+        fprintf(stderr, "[ROM] not importing: %s exists and is not this cartridge\n", imported);
+        return rom_path;
+    }
+    char temp[1040];
+    snprintf(temp, sizeof temp, "%s.part", imported);
+    FILE *f = fopen(temp, "wb");
+    int ok = f && fwrite(data, 1, size, f) == size;
+    if (f && fclose(f) != 0) ok = 0;
+    if (!ok || rename(temp, imported) != 0) {
+        remove(temp);
+        fprintf(stderr, "[ROM] could not import the cartridge into %s\n", s_data_dir);
+        return rom_path;
+    }
+    fprintf(stderr, "[ROM] imported cartridge: %s\n", imported);
+    return imported;
+}
+
 int main(int argc, char *argv[])
 {
     /* SDL2's Wayland app id and X11 resource class must agree with the
@@ -2424,6 +2515,9 @@ int main(int argc, char *argv[])
