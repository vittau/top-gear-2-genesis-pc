From 58d68bc23d1c9a7f45167022b38140a8c376937a Mon Sep 17 00:00:00 2001
From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Date: Thu, 12 Nov 2026 10:52:20 -0300
Subject: [PATCH] Integrate runtime menu and controller input

Provide clean menu dismissal, photo freeze and quit, retain slot hotkeys and expose additive triggers plus dev axis probes.
---
 runner/cmd_server.c |  19 +++++++-
 runner/game_spec.h  |   8 ++++
 runner/gamepad.c    |  10 ++++
 runner/input_map.c  |  66 +++++++++++++++++++++++---
 runner/input_map.h  |  12 ++++-
 runner/main.c       | 112 +++++++++++++++++++++++++++++++++++++-------
 6 files changed, 201 insertions(+), 26 deletions(-)

diff --git a/runner/cmd_server.c b/runner/cmd_server.c
index 0308abb..febd861 100644
--- a/runner/cmd_server.c
