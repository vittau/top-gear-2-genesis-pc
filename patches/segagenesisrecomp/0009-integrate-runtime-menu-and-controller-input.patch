+     * NULL = no trigger input (the shared default). */
+    uint16_t (*pad_trigger_bits)(int player, int lt_held, int rt_held);
     /* Host players live out of the box, before settings.ini: 0/1 keeps the
      * shared default (player 1 only), 2 also enables player 2's default
      * bindings (right-hand keyboard set + second gamepad). A saved
diff --git a/runner/gamepad.c b/runner/gamepad.c
index 24e04ef..67e42d9 100644
--- a/runner/gamepad.c
+++ b/runner/gamepad.c
@@ -15,6 +15,7 @@
 
 #include "gamepad.h"
 #include "input_map.h"
+#include "game_spec.h"
 
 #include <SDL2/SDL.h>
 #include <stdio.h>
@@ -167,6 +168,15 @@ uint16_t gamepad_player_mask(int player)
     if (ly < -dz) m |= input_button_bit(GB_UP);
     if (ly >  dz) m |= input_button_bit(GB_DOWN);
 
+    /* Additive analog pedals, when the game asks for them: a trigger past the
+     * same deadzone presses the game's accelerate/brake button for this
+     * player, alongside (never instead of) the face-button bindings. */
+    if (g_game_spec.pad_trigger_bits) {
+        int lt = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_TRIGGERLEFT);
+        int rt = SDL_GameControllerGetAxis(c, SDL_CONTROLLER_AXIS_TRIGGERRIGHT);
+        m |= g_game_spec.pad_trigger_bits(player, lt > dz, rt > dz);
+    }
+
     return m;
 }
 
diff --git a/runner/input_map.c b/runner/input_map.c
index e507ee7..5f01659 100644
--- a/runner/input_map.c
+++ b/runner/input_map.c
@@ -9,8 +9,59 @@
 
 InputMap g_input_map;
 static int s_gameplay_blocked;
+/* Buttons still held at the instant gameplay input was unblocked (the key or
+ * pad button that accepted the runtime-menu row). They stay out of the guest
+ * until the player releases them, so dismissing the menu cannot also press
+ * START/accept in the game. */
+static uint16_t s_held_on_unblock[INPUT_MAX_PLAYERS];
 
-void input_set_gameplay_blocked(int blocked) { s_gameplay_blocked = !!blocked; }
+#if GEN_ENABLE_TRACE
+/* Dev/TCP test seam: headless SDL cannot fake SDL_GetKeyboardState, so a probe
+ * may stand in for a physically held key. It feeds exactly the same reads the
+ * real keyboard state does (input_map_key_mask). */
+static Uint8 s_test_keys[SDL_NUM_SCANCODES];
+static int s_test_keys_on;
+void input_test_key_hold(int scancode, int down)
+{
+    if (scancode < 0 || scancode >= SDL_NUM_SCANCODES) return;
+    s_test_keys_on = 1;
+    s_test_keys[scancode] = down ? 1 : 0;
+}
+void input_test_keys_clear(void)
+{
+    memset(s_test_keys, 0, sizeof s_test_keys);
+    s_test_keys_on = 1;
+}
+static const Uint8 *keyboard_state(void)
+{
+    return s_test_keys_on ? s_test_keys : SDL_GetKeyboardState(NULL);
+}
+#else
+static const Uint8 *keyboard_state(void) { return SDL_GetKeyboardState(NULL); }
+#endif
+
+/* Keyboard + gamepad contribution, ignoring the gameplay block and the
+ * release latch: the true physical state. */
+static uint16_t raw_mask(int player)
+{
+    const PlayerInput *pi = &g_input_map.p[player];
+    uint16_t m = 0;
+    if (pi->device & INPUT_DEV_KEYBOARD) m |= input_map_key_mask(player);
+    if (pi->device & INPUT_DEV_GAMEPAD)  m |= gamepad_player_mask(player);
+    return m;
+}
+
+void input_set_gameplay_blocked(int blocked)
+{
+    blocked = !!blocked;
+    if (blocked) {
+        memset(s_held_on_unblock, 0, sizeof s_held_on_unblock);
+    } else if (s_gameplay_blocked) {
+        for (int p = 0; p < INPUT_MAX_PLAYERS; ++p)
+            s_held_on_unblock[p] = raw_mask(p);
+    }
+    s_gameplay_blocked = blocked;
+}
 int input_gameplay_blocked(void) { return s_gameplay_blocked; }
 void input_gameplay_capture_changed(void *context,int open)
 { (void)context;input_set_gameplay_blocked(open); }
@@ -45,6 +96,7 @@ void input_map_init_defaults(void)
 {
     memset(&g_input_map, 0, sizeof(g_input_map));
     s_gameplay_blocked = 0;
+    memset(s_held_on_unblock, 0, sizeof s_held_on_unblock);
 
     PlayerInput *p1 = &g_input_map.p[0];
     /* Default = keyboard AND gamepad, additive (same merge rule as the
@@ -103,7 +155,7 @@ void input_map_init_defaults(void)
 uint16_t input_map_key_mask(int player)
 {
     if (player < 0 || player >= INPUT_MAX_PLAYERS) return 0;
-    const Uint8 *ks = SDL_GetKeyboardState(NULL);
+    const Uint8 *ks = keyboard_state();
     if (!ks) return 0;
     const PlayerInput *pi = &g_input_map.p[player];
     uint16_t m = 0;
@@ -119,11 +171,11 @@ uint16_t input_current_mask(int player)
 {
     if (s_gameplay_blocked) return 0;
     if (player < 0 || player >= INPUT_MAX_PLAYERS) return 0;
-    const PlayerInput *pi = &g_input_map.p[player];
-    uint16_t m = 0;
-    if (pi->device & INPUT_DEV_KEYBOARD) m |= input_map_key_mask(player);
-    if (pi->device & INPUT_DEV_GAMEPAD)  m |= gamepad_player_mask(player);
-    return m;
+    uint16_t m = raw_mask(player);
+    /* Suppress only while still held: the release clears the latch, so the
+     * next real press of the same button reaches the game normally. */
+    s_held_on_unblock[player] &= m;
+    return (uint16_t)(m & (uint16_t)~s_held_on_unblock[player]);
 }
 
 cc_bool input_player_enabled(int player)
