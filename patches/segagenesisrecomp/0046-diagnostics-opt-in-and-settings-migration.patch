+    /* Task 32 migration. A version-1 settings.ini wrote
+     * `[mods.diagnostics] enabled = 1` because that was the DEFAULT (the
+     * Diagnostics mod was on for everybody), not because the player chose it.
+     * Diagnostics are opt-in from version 2 on: force them off here and let
+     * the caller rewrite the file once (app_config_migrated()). A version-2
+     * file keeps exactly what it saved, so a deliberate enable survives. */
+    if (s_settings_version < APP_CONFIG_SETTINGS_VERSION) {
+        s_migrated = 1;
+        if (g_app_config.replay_diagnostics)
+            fprintf(stderr, "[config] migrating settings.ini: diagnostics are now opt-in\n");
+        g_app_config.replay_diagnostics = 0;
