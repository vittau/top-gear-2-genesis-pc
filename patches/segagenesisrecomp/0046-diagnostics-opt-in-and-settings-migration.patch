diff --git a/runner/app_config.h b/runner/app_config.h
--- a/runner/app_config.h
+++ b/runner/app_config.h
@@ -38,11 +38,22 @@
     int rewind_enabled;     /* local rewind; never available in netplay */
     int rewind_depth;       /* snapshot slots */
     int rewind_interval;    /* guest frames between snapshots */
-    int replay_diagnostics; /* default-on replayable player feedback */
+    int replay_diagnostics; /* opt-in replayable player feedback (--debug) */
 } AppConfig;
 
+/* settings.ini schema version, stamped as [meta] settings_version. Version 2
+ * (task 32) made the feedback replay/diagnostics opt-in; a version-1 file
+ * saved `[mods.diagnostics] enabled = 1` as the old default, so it must load
+ * with diagnostics off and be rewritten once. */
+#define APP_CONFIG_SETTINGS_VERSION 2
+
 extern AppConfig g_app_config;
 
+/* 1 when the settings.ini just read predates APP_CONFIG_SETTINGS_VERSION and
+ * still has to be rewritten (diagnostics already forced off). Cleared by the
+ * next app_config_load(); 0 when the file is missing or current. */
+int  app_config_migrated(void);
+
 /* Reset g_app_config to defaults (does NOT touch g_input_map). */
 void app_config_defaults(void);
 
