+/* Process-scoped diagnostics (`--debug`). The feedback replay records when
+ * either the saved Diagnostics option or this flag is set; the flag is never
+ * written back to settings.ini, so a debug launch cannot leave a normal
+ * install recording replays. */
+void app_config_set_debug_diagnostics(int on);
+int  app_config_diagnostics_active(void);
