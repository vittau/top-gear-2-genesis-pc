From f43d60a4a3e3b80370b1e8e8b39cc5af810dc3f8 Mon Sep 17 00:00:00 2001
From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Date: Thu, 12 Nov 2026 10:52:20 -0300
Subject: [PATCH] Apply runtime layout policy and wrap help footers

Share explicit section policy across both menu backends and reserve measured software help height above settings rows.
---
 src/common/recomp_runtime_settings.c |   4 +
 src/common/recomp_runtime_ui.c       | 113 ++++++++++++++++++++++-----
 src/recomp_runtime_ui.h              |  10 +++
 3 files changed, 108 insertions(+), 19 deletions(-)

diff --git a/src/common/recomp_runtime_settings.c b/src/common/recomp_runtime_settings.c
index 5358de4..8599621 100644
--- a/src/common/recomp_runtime_settings.c
+++ b/src/common/recomp_runtime_settings.c
@@ -203,6 +203,10 @@ RecompRuntimeUi *recomp_runtime_ui_create_standard(
         count += standard->extra_item_count;
     }
 
+    if (standard->menu.layout && standard->menu.layout->section_name)
+        for (size_t i = 0; i < count; ++i)
+            items[i].section = standard->menu.layout->section_name(items[i].section);
+
     RecompRuntimeUiConfig menu = standard->menu;
     menu.items = items;
     menu.item_count = count;
diff --git a/src/common/recomp_runtime_ui.c b/src/common/recomp_runtime_ui.c
index 809061c..ea91798 100644
--- a/src/common/recomp_runtime_ui.c
+++ b/src/common/recomp_runtime_ui.c
@@ -238,6 +238,21 @@ RecompRuntimeUi *recomp_runtime_ui_create(const RecompRuntimeUiConfig *config) {
         name[len] = '\0';
         ui->sections[ui->section_count++] = name;
     }
+    /* Explicit host order controls both visible rows and controller focus.
+     * Unlisted sections retain first-seen order after the listed ones. */
+    if (config->layout && config->layout->section_order) {
+        size_t next = 0;
+        for (size_t i = 0; i < config->layout->section_count; ++i) {
+            for (size_t j = next; j < ui->section_count; ++j) {
+                if (!same_text(ui->sections[j], config->layout->section_order[i])) continue;
+                const char *section = ui->sections[j];
+                memmove(ui->sections + next + 1, ui->sections + next,
+                        (j - next) * sizeof(*ui->sections));
+                ui->sections[next++] = section;
+                break;
+            }
+        }
+    }
     return ui;
 }
 
@@ -628,12 +643,13 @@ static void outline(void *pixels, int width, int height, int pitch, int x, int y
     rect(pixels,width,height,pitch,x+w-thickness,y,thickness,h,color,255);
 }
 
-static void draw_text(void *pixels, int width, int height, int pitch, int x,
-                      int y, int scale, uint32_t color, const char *text,
-                      int max_x) {
+static void draw_text_range(void *pixels, int width, int height, int pitch, int x,
+                            int y, int scale, uint32_t color, const char *text,
+                            const char *end, int max_x) {
     if (!text) return;
     int cursor = x;
-    for (const unsigned char *p = (const unsigned char *)text; *p; ++p) {
+    for (const unsigned char *p = (const unsigned char *)text;
+         *p && (!end || p < (const unsigned char *)end); ++p) {
         if (*p >= 0x80) continue;
         if (cursor + 5 * scale > max_x) break;
         uint64_t bits = glyph_bits(*p);
@@ -648,6 +664,47 @@ static void draw_text(void *pixels, int width, int height, int pitch, int x,
     }
 }
 
+static void draw_text(void *pixels, int width, int height, int pitch, int x,
+                      int y, int scale, uint32_t color, const char *text,
+                      int max_x) {
+    draw_text_range(pixels,width,height,pitch,x,y,scale,color,text,NULL,max_x);
+}
+
+/* Measure and draw the same word boundaries. An overlong word is split so
+ * even descriptions without spaces stay inside the panel. Non-ASCII bytes
+ * consume no glyph cells, matching the existing bitmap-font renderer. */
+static const char *help_line_end(const char *text, int columns,
+                                 const char **next) {
+    const char *p = text, *space = NULL;
+    int cells = 0;
+    while (*p && *p != '\n') {
+        if ((unsigned char)*p < 0x80) {
+            if (cells == columns) break;
+            ++cells;
+            if (*p == ' ' || *p == '\t') space = p;
+        }
+        ++p;
+    }
+    const char *end = p;
+    if (*p && *p != '\n' && *p != ' ' && *p != '\t' && space)
+        end = space;
+    *next = end;
+    while (**next == ' ' || **next == '\t') ++*next;
+    if (**next == '\n') ++*next;
+    return end;
+}
+
+static int help_line_count(const char *text, int columns) {
+    int lines = 0;
+    while (*text) {
+        const char *next;
+        help_line_end(text,columns,&next);
+        text = next;
+        ++lines;
+    }
+    return lines ? lines : 1;
+}
+
 static int text_width(const char *text, int scale) {
     int count = 0;
     if (!text) return 0;
@@ -822,15 +879,33 @@ void recomp_runtime_ui_render_argb8888(RecompRuntimeUi *ui, void *pixels,
          panel_w-pad*2,scale,border,255);
 
     int list_y = panel_y + 32 * scale + header_extra;
-    int footer_y = panel_y + panel_h - 28 * scale;
-    int row_h = 15 * scale;
+    const char *help = "UP/DOWN SELECT  LEFT/RIGHT CHANGE  ENTER ACCEPT";
+    if (ui->in_section) {
+        char folder[96];
+        const RecompRuntimeUiItem *item = recomp_runtime_ui_page_entry(
+            ui, ui->row_index, folder, sizeof(folder));
+        if (item && item->description && *item->description) help = item->description;
+        else if (!item && folder[0]) help = "ENTER OPEN  ESC BACK";
+    }
+
+    const int row_h = 15 * scale, help_row_h = 9 * scale;
+    int columns = (panel_w - pad * 2 + scale) / (6 * scale);
+    if (columns < 1) columns = 1;
+    int help_lines = help_line_count(help,columns);
+    /* Keep one settings row when possible. On very small surfaces or for
+     * unbounded third-party text, clip vertically rather than overlap rows
+     * or draw outside the panel. Current host descriptions fit in full. */
+    int max_help_lines = 1 + (panel_y + panel_h - 28 * scale - list_y - row_h) / help_row_h;
+    if (max_help_lines < 1) max_help_lines = 1;
+    if (help_lines > max_help_lines) help_lines = max_help_lines;
+    int footer_y = panel_y + panel_h - 28 * scale - (help_lines - 1) * help_row_h;
     int visible = (footer_y - list_y) / row_h;
-    if (visible < 1) visible = 1;
+    if (visible < 0) visible = 0;
     size_t count = ui->in_section ? recomp_runtime_ui_page_entry_count(ui)
                                   : ui->section_count;
     size_t selection = ui->in_section ? ui->row_index : ui->section_index;
     size_t first = 0;
-    if (selection >= (size_t)visible) first = selection - (size_t)visible + 1;
+    if (visible && selection >= (size_t)visible) first = selection - (size_t)visible + 1;
     for (int line = 0; line < visible && first + (size_t)line < count; ++line) {
         size_t index = first + (size_t)line;
         int y = list_y + line * row_h;
@@ -865,18 +940,18 @@ void recomp_runtime_ui_render_argb8888(RecompRuntimeUi *ui, void *pixels,
         }
     }
 
-    const char *help = "UP/DOWN SELECT  LEFT/RIGHT CHANGE  ENTER ACCEPT";
-    if (ui->in_section) {
-        char folder[96];
-        const RecompRuntimeUiItem *item = recomp_runtime_ui_page_entry(
-            ui, ui->row_index, folder, sizeof(folder));
-        if (item && item->description && *item->description) help = item->description;
-        else if (!item && folder[0]) help = "ENTER OPEN  ESC BACK";
+    if (footer_y - 4 * scale >= panel_y + pad)
+        rect(pixels,width,height,pitch,panel_x+pad,footer_y-4*scale,
+             panel_w-pad*2,scale,border,255);
+    for (int line = 0; *help && line < help_lines; ++line) {
+        const int y = footer_y + 3 * scale + line * help_row_h;
+        if (y < panel_y + pad || y + 7 * scale > panel_y + panel_h - 18 * scale) break;
+        const char *next;
+        const char *end = help_line_end(help,columns,&next);
+        draw_text_range(pixels,width,height,pitch,panel_x+pad,y,scale,
+                        muted,help,end,panel_x+panel_w-pad);
+        help = next;
     }
-    rect(pixels,width,height,pitch,panel_x+pad,footer_y-4*scale,
-         panel_w-pad*2,scale,border,255);
-    draw_text(pixels,width,height,pitch,panel_x+pad,footer_y+3*scale,scale,
-              muted,help,panel_x+panel_w-pad);
     if (ui->status_frames) {
         int status_w = text_width(ui->status, scale);
         draw_text(pixels,width,height,pitch,panel_x+panel_w-pad-status_w,
diff --git a/src/recomp_runtime_ui.h b/src/recomp_runtime_ui.h
index 8d7775e..42dc9ad 100644
--- a/src/recomp_runtime_ui.h
+++ b/src/recomp_runtime_ui.h
@@ -130,6 +130,15 @@ typedef struct RecompRuntimeUiCallbacks {
                     const char *value);
 } RecompRuntimeUiCallbacks;
 
+/* Optional host policy over the effective standard + extra descriptors.
+ * The policy and all strings it returns must outlive the menu. */
+typedef struct RecompRuntimeUiLayout {
+    /* Maps effective descriptor sections when create_standard is used. */
+    const char *(*section_name)(const char *section);
+    const char *const *section_order;
+    size_t section_count;
+} RecompRuntimeUiLayout;
+
 typedef struct RecompRuntimeUiConfig {
     const char *title;
     const char *subtitle;
@@ -161,6 +170,7 @@ typedef struct RecompRuntimeUiConfig {
      * the default, where every row can take the selection.
      */
     uint32_t navigation_flags;
+    const RecompRuntimeUiLayout *layout;
 } RecompRuntimeUiConfig;
 
 enum {
