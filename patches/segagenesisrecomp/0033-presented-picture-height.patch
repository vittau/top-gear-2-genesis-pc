From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Date: Mon, 9 Nov 2026 12:00:00 -0300
Subject: [PATCH] Present pictures taller than the VDP geometry

Add GameVideo.present_frame: called once per completed frame, after every
native row was produced and before the presented-window crop, it lets a game
provider rewrite the runner framebuffer as a taller picture and report how
many complete rows it wrote. The crop, framebuffer hashes, screenshots, the
runtime overlay and the logical canvas all follow that height. MAX_SCREEN_HEIGHT
grows to 4 x 224 so the buffers and the texture fit (interlace mode 2 still
fits at 448), and the interlace halving/clamping now keys on the VDP's
interlace mode instead of a height threshold, so a tall non-interlaced
picture is not squashed to half height.
---
 runner/game_video.h | 12 ++++++++++++
 runner/main.c       | 40 ++++++++++++++++++++++++++++++++++++++------
 2 files changed, 46 insertions(+), 6 deletions(-)

diff --git a/runner/game_video.h b/runner/game_video.h
--- a/runner/game_video.h
+++ b/runner/game_video.h
@@ -85,6 +85,18 @@
      * Never enters disk states, deterministic RB images, or netplay digests. */
     size_t (*presentation_state_save)(void *dst, size_t capacity);
     int (*presentation_state_load)(const void *src, size_t size, int apply);
+    /* Optional end-of-frame composition for a presented picture larger than
+     * the machine's native geometry (a game-owned render scale). Called once
+     * per completed frame, after every native row was produced and before the
+     * presented-window crop, screenshots, hashes and upload. `pixels` is the
+     * runner framebuffer with `stride_pixels` per row and room for a picture up
+     * to MAX_SCREEN_HEIGHT rows; the provider may rewrite it in place and must
+     * not read or write guest state. Return the number of complete rows it
+     * wrote: a value above native_h selects that presented height, anything
+     * else keeps the machine's own picture and height. NULL keeps the machine's
+     * picture. */
+    int (*present_frame)(uint32_t *pixels, int stride_pixels, int width,
+                         int native_w, int native_h);
 } GameVideo;
 
 /* Host-local derived frame plan, never deterministic machine/snapshot state.
diff --git a/runner/main.c b/runner/main.c
--- a/runner/main.c
+++ b/runner/main.c
@@ -245,7 +245,10 @@
  * interlace height. Custom presentation grows the stride/texture dynamically;
  * it is not limited by the VDP's 512px plane or a fixed aspect-ratio preset. */
 #define NATIVE_SCREEN_STRIDE 512
-#define MAX_SCREEN_HEIGHT 480
+/* A game-owned render scale may present a picture taller than the VDP's own
+ * geometry (present_frame, game_video.h). 896 = 4 x 224 covers the largest
+ * supported high-resolution picture; interlace mode 2 (448) still fits. */
+#define MAX_SCREEN_HEIGHT 896
 static int s_frame_stride = NATIVE_SCREEN_STRIDE;
 #define MAX_SCREEN_WIDTH s_frame_stride
 
@@ -684,6 +687,10 @@
 
 static int s_screen_width  = 320;
 static int s_screen_height = 224;
+/* Interlace mode 2 (the only source of a double-height native picture). A
+ * presented picture may also be taller than 224 for an unrelated reason (a
+ * game-owned render scale), so the height alone must never imply interlace. */
+static int s_screen_interlaced;
 
 /* Some games render two local views as stacked halves of a double-height VDP
  * frame. Opted-in netplay targets may present only the local peer's half. The
@@ -691,8 +698,8 @@
 static int netplay_peer_view_active(void)
 {
 #if GENESIS_HAS_RECOMP_NET && GENESIS_NETPLAY_PEER_VIEW
-    return genesis_netplay_active() && s_screen_height > 240 &&
-           (s_screen_height & 1) == 0;
+    return genesis_netplay_active() && s_screen_interlaced &&
+           s_screen_height > 240 && (s_screen_height & 1) == 0;
 #else
     return 0;
 #endif
@@ -728,7 +735,8 @@
 {
     if (netplay_peer_view_active())
         return s_screen_height / 2;
-    if (s_screen_height > 240 && s_interlace_display_mode == INTERLACE_DISPLAY_TV)
+    if (s_screen_interlaced && s_screen_height > 240 &&
+        s_interlace_display_mode == INTERLACE_DISPLAY_TV)
         return (s_screen_height + 1) / 2;
     return s_screen_height;
 }
@@ -4374,6 +4382,18 @@
            * the existing interlace display modes (tv squash / raw) take over
            * from here, same as the clownmdemu path. */
           s_screen_height = gvdp_output_height(&g_machine.vdp);
+          s_screen_interlaced = gvdp_interlace_double(&g_machine.vdp);
+          /* A game-owned render scale may have already written a taller
+           * presented picture into the framebuffer (present_frame). It reports
+           * the number of complete rows it wrote; everything below (crop,
+           * hashes, screenshots, the logical canvas, the texture) follows it. */
+          if (completed && s_video_frame.owner && s_video_frame.owner->present_frame) {
+              int presented = s_video_frame.owner->present_frame(
+                  s_framebuf, MAX_SCREEN_WIDTH, s_screen_width,
+                  gvdp_active_width(&g_machine.vdp), s_screen_height);
+              if (presented > s_screen_height && presented <= MAX_SCREEN_HEIGHT)
+                  s_screen_height = presented;
+          }
           if (s_video_frame.owner && s_video_frame.owner->present_window) {
               int first = 0, last = 0;
               if (s_video_frame.owner->present_window(s_screen_width, s_screen_height,
