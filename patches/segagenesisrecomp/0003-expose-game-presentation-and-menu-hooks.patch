      * "21:9" or "32:9" enables it. A saved choice, including off, still wins. */
     const char *video_default;
     unsigned logical_players;       /* 0 = native two ports; host input/UI capacity */
+    /* Host players live out of the box, before settings.ini: 0/1 keeps the
+     * shared default (player 1 only), 2 also enables player 2's default
+     * bindings (right-hand keyboard set + second gamepad). A saved
+     * [input.pN] device still wins, so an existing settings.ini is untouched
+     * and a single-controller setup keeps one player alive. */
+    unsigned default_players;
     void (*load_settings)(const char *settings_path);
+    /* Game-owned settings written into the same settings.ini after the
+     * engine's shared sections have been rewritten. Return 1 on success. */
+    int  (*save_settings)(const char *settings_path);
+    /* Game-owned rows appended to the in-game recomp-ui settings menu. The
+     * returned RecompRuntimeUiItem array and its strings must stay valid for
+     * the lifetime of the menu. get/set receive the item's key. */
+    const struct RecompRuntimeUiItem *(*runtime_ui_items)(size_t *count);
+    int (*runtime_ui_get)(const char *key, int *out);
+    int (*runtime_ui_set)(const char *key, int value);
     /* Game-owned additive features may compose with the common video provider. */
     const struct RecompLauncherCModProvider *(*mods)(
         const struct RecompLauncherCModProvider *base);
@@ -66,6 +82,15 @@ typedef struct GameSpec {
      * Hedgehog". Build/backend/debug identity belongs in logs and About. */
