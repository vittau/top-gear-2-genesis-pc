From 648306924492eae98cfd5805af77ad5afee80ba0 Mon Sep 17 00:00:00 2001
From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Date: Thu, 12 Nov 2026 10:52:19 -0300
Subject: [PATCH] Expose game presentation and menu hooks

Let the game own settings, native video geometry, app identity and player defaults without embedding game policy in the runner.
---
 runner/app_config.c |   6 +-
 runner/game_spec.h  |  26 ++++++
 runner/game_video.h |  34 +++++++-
 runner/main.c       | 196 ++++++++++++++++++++++++++++++++++++++++----
 4 files changed, 245 insertions(+), 17 deletions(-)

diff --git a/runner/app_config.c b/runner/app_config.c
index 0701202..041453b 100644
--- a/runner/app_config.c
+++ b/runner/app_config.c
@@ -4,6 +4,7 @@
 #include "app_config.h"
 #include "input_map.h"
 #include "game_video.h"
+#include "game_spec.h"
 
 #include <stdio.h>
 #include <stdlib.h>
@@ -407,7 +408,10 @@ static int video_mod_commit(void *ctx,const char *image)
     (void)ctx;(void)image;s_mod_error[0]=0;
     /* Keep any controller rebindings the launcher already persisted. */
     app_config_reload_preserving_mods(s_mod_settings);
-    if(app_config_save(s_mod_settings))return 1;
+    if(app_config_save(s_mod_settings))
+        return !g_game_spec.save_settings ||
+               g_game_spec.save_settings(s_mod_settings);
+    fprintf(stderr,"[mods] app_config_save failed: %s\n", s_mod_settings);
     MOD_COPY(s_mod_error,"Unable to save widescreen settings.ini");return 0;
 }
 static const char *video_mod_error(void *ctx) { (void)ctx;return s_mod_error; }
