diff --git a/runner/game_video.h b/runner/game_video.h
index 5a2722d..578b4d3 100644
--- a/runner/game_video.h
+++ b/runner/game_video.h
@@ -45,6 +45,15 @@ typedef struct GameVideo {
      * unsupported row. NULL retains the legacy enabled/width qualification.
      * This does not enable scene hooks, change simulation or configure a mode. */
     int (*renderer_enabled)(void);
+    /* Optional presented scanline window: crop empty bands without touching
+     * the guest picture. Called once per completed frame, after every row was
+     * produced, so a provider may decide from that frame's actual pixels.
+     * Returning 1 with 0 <= first < last <= native_h makes the presentation
+     * path shift rows [first,last) to the top of the framebuffer and report a
+     * last-first tall image to screenshots, hashes, the runtime overlay and
+     * the logical canvas. Guest output, per-line captures and the margin
+     * audit are unaffected. NULL/false keeps the machine's own height. */
+    int (*present_window)(int native_w, int native_h, int *first, int *last);
     /* Request immutable native plane/sprite inputs before evaluation. Only
      * requested rows pay for plane capture. Presentation providers are consumed
      * synchronously into owned pixels/masks/colors. NULL raster retains the
@@ -76,6 +85,26 @@ typedef struct GameVideo {
      * Never enters disk states, deterministic RB images, or netplay digests. */
     size_t (*presentation_state_save)(void *dst, size_t capacity);
     int (*presentation_state_load)(const void *src, size_t size, int apply);
+    /* Optional end-of-frame composition for a presented picture larger than
+     * the machine's native geometry (a game-owned render scale). Called once
+     * per completed frame, after every native row was produced and before the
+     * presented-window crop, screenshots, hashes and upload. `pixels` is the
+     * runner framebuffer with `stride_pixels` per row and room for a picture up
+     * to MAX_SCREEN_HEIGHT rows; the provider may rewrite it in place and must
+     * not read or write guest state. Return the number of complete rows it
+     * wrote: a value above native_h selects that presented height, anything
+     * else keeps the machine's own picture and height. NULL keeps the machine's
+     * picture. */
+    int (*present_frame)(uint32_t *pixels, int stride_pixels, int width,
+                         int native_w, int native_h);
+    /* Optional: the provider owns the presented row width even while its
+     * viewport mode is off (a game-owned render scale is not a widescreen
+     * mode). Returning non-zero makes width() publish the presented canvas
+     * width for the frame without changing enabled() / the viewport policy,
+     * so a game's render-scale provider gets a wider canvas with widescreen
+     * off and every UI row still reports the real option state. NULL keeps
+     * the enabled()-gated width. */
+    int (*presented_width)(void);
 } GameVideo;
 
 /* Host-local derived frame plan, never deterministic machine/snapshot state.
@@ -103,7 +132,10 @@ static inline GameVideoFrame game_video_prepare_frame(const GameVideo *video,
     if(!video || native_w<=0 || native_h<=0)return frame;
     /* Width may publish simulation state. Always do it before local ownership
      * or texture eligibility, including when the selected renderer declines. */
-    if(video->enabled && video->enabled() && video->width)
+    int publish_width=video->enabled ? video->enabled() : 0;
+    if(!publish_width && video->width && video->presented_width &&
+       video->presented_width())publish_width=1;
+    if(publish_width && video->width)
         frame.requested_width=video->width(drawable_w,drawable_h,native_w,native_h);
     int valid_width=frame.requested_width>=native_w;
     frame.viewport=valid_width;
