+/* Controller-only operation of the runtime menu. Back+RB (the pad's overlay
+ * binding) opens or closes it; the D-pad moves, A accepts, B goes back and X
+ * closes. The keyboard path above is unchanged. */
+int runner_runtime_ui_open(void) {
+    return s_runtime_ui.ui && recomp_runtime_ui_is_open(s_runtime_ui.ui);
+}
+static void runtime_ui_gamepad(void) {
+    if (!s_runtime_ui.ui) return;
+    uint32_t pad = gamepad_overlay_mask();
+    static uint32_t prev_pad, repeat_dir, repeat_at;
+    static int combo_prev;
+    const uint32_t combo_bits = GP_OVERLAY_BACK | GP_OVERLAY_RB;
+    const int combo = (pad & combo_bits) == combo_bits;
+    if (combo && !combo_prev && !recomp_runtime_ui_wants_text_input(s_runtime_ui.ui)) {
+        recomp_runtime_ui_handle_input(s_runtime_ui.ui, RECOMP_RUNTIME_UI_INPUT_TOGGLE, 1, 0);
+        combo_prev = combo; prev_pad = pad; return;
+    }
+    combo_prev = combo;
+    if (!recomp_runtime_ui_is_open(s_runtime_ui.ui) ||
+        recomp_runtime_ui_wants_text_input(s_runtime_ui.ui)) {
+        prev_pad = pad; repeat_dir = 0; return;
+    }
+    uint32_t press = pad & ~prev_pad;
+    prev_pad = pad;
+    int dir_input = -1;
+    if (press & GP_OVERLAY_UP) dir_input = RECOMP_RUNTIME_UI_INPUT_UP;
+    else if (press & GP_OVERLAY_DOWN) dir_input = RECOMP_RUNTIME_UI_INPUT_DOWN;
+    else if (press & GP_OVERLAY_LEFT) dir_input = RECOMP_RUNTIME_UI_INPUT_LEFT;
+    else if (press & GP_OVERLAY_RIGHT) dir_input = RECOMP_RUNTIME_UI_INPUT_RIGHT;
+    if (dir_input >= 0)
+        recomp_runtime_ui_handle_input(s_runtime_ui.ui, dir_input, 1, 0);
+    else if (press & GP_OVERLAY_A)
+        recomp_runtime_ui_handle_input(s_runtime_ui.ui, RECOMP_RUNTIME_UI_INPUT_ACCEPT, 1, 0);
+    else if (press & GP_OVERLAY_B)
+        recomp_runtime_ui_handle_input(s_runtime_ui.ui, RECOMP_RUNTIME_UI_INPUT_BACK, 1, 0);
+    else if (press & GP_OVERLAY_X)
+        recomp_runtime_ui_handle_input(s_runtime_ui.ui, RECOMP_RUNTIME_UI_INPUT_TOGGLE, 1, 0);
+    if (recomp_runtime_ui_is_open(s_runtime_ui.ui)) {
+        uint32_t dir = pad & (GP_OVERLAY_UP | GP_OVERLAY_DOWN |
+                              GP_OVERLAY_LEFT | GP_OVERLAY_RIGHT);
+        uint32_t now = SDL_GetTicks();
+        if (dir != repeat_dir) {
+            repeat_dir = dir;
+            repeat_at = now + 350;
+        } else if (dir && (int32_t)(now - repeat_at) >= 0) {
+            int input = (dir & GP_OVERLAY_UP) ? RECOMP_RUNTIME_UI_INPUT_UP
+                      : (dir & GP_OVERLAY_DOWN) ? RECOMP_RUNTIME_UI_INPUT_DOWN
+                      : (dir & GP_OVERLAY_LEFT) ? RECOMP_RUNTIME_UI_INPUT_LEFT
+                                                : RECOMP_RUNTIME_UI_INPUT_RIGHT;
+            recomp_runtime_ui_handle_input(s_runtime_ui.ui, input, 1, 1);
+            repeat_at = now + 90;
+        }
+    }
+}
