+/* Evidence manifests are development artifacts: a trace build (the default
+ * for tools/build-linux.sh) keeps writing them, a release build writes
+ * nothing unless --debug asked for them. */
+#if GEN_ENABLE_TRACE
+#define RT_EVIDENCE_BUILD_DEFAULT 1
+#else
+#define RT_EVIDENCE_BUILD_DEFAULT 0
+#endif
+static int s_enabled = -1;   /* -1 = build default, 0 off, 1 on */
 
+void runtime_evidence_set_enabled(int on) { s_enabled = on != 0; }
+
 static void evidence_atexit(void) { runtime_evidence_flush(); }
 
