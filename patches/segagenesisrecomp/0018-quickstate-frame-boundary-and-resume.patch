From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Date: Sat, 7 Nov 2026 05:10:00 -0300
Subject: [PATCH] Game-chosen quickstate boundaries and an explicit resume PC

A game whose screens spin on their own hardware flags has no shared
WaitForVint park, so a host snapshot was only ever taken at whatever
instruction the save command happened to interrupt. Loading that file in a
fresh process resumed the restored CPU inside the new process's boot chain:
the guest ran on while the picture froze.

Let a game hook offer a per-frame boundary (`glue_state_boundary`) that parks
a queued save at a repeatable instruction, and let the adapter name the PC to
restart the game fiber at after a load (`state_resume_pc`). Games that set
neither keep the existing behaviour.
---
diff --git a/runner/game_spec.h b/runner/game_spec.h
index 652114a..199d46e 100644
--- a/runner/game_spec.h
+++ b/runner/game_spec.h
@@ -71,6 +71,13 @@ typedef struct GameSpec {
     int (*state_load)(const void *data, size_t size, int apply);
     /* At the game's real WaitForVint: is its caller a resumable loop? */
     int (*state_at_boundary)(void);
+    /* At a short hardware-poll loop: does `site` (the polled instruction the
+     * loop re-executes) qualify as a resumable frame boundary? */
+    int (*state_at_boundary_site)(uint32_t site);
+    /* Resume PC after a host snapshot was applied. Called on the scheduler
+     * fiber once the adapter's state_load(apply) has prepared it. 0 falls
+     * back to resume_main_loop_pc. */
+    uint32_t (*state_resume_pc)(void);
     /* ---- Identity ---- */
     /* Clean game name for gameplay and launcher captions, e.g. "Sonic the
      * Hedgehog". Build/backend/debug identity belongs in logs and About. */
diff --git a/runner/glue.c b/runner/glue.c
index 973552e..ed086a8 100644
--- a/runner/glue.c
+++ b/runner/glue.c
@@ -1214,6 +1214,23 @@ void glue_yield_for_vblank(void)
     }
 }
 
+/* A game-chosen per-frame instruction (a loop top that the screen
+ * re-executes) asks here whether it should park for a host snapshot. On a
+ * queued save this yields to the scheduler at the instruction boundary and
+ * stays parked until the snapshot has been written; the guest resumes in
+ * place afterwards. Returns 1 when the call parked. */
+int glue_state_boundary(uint32_t site)
+{
+    if (!s_state_requested || s_in_vblank_service || !s_main_fiber ||
+        !g_game_spec.state_at_boundary_site)
+        return 0;
+    if (!g_game_spec.state_at_boundary_site(site))
+        return 0;
+    s_state_parked = 1;
+    yield_to_main(GLUE_YIELD_VBLANK);
+    return 1;
+}
+
 /* Yield from a short hardware-polling loop without declaring a game-frame
  * boundary. This lets clownmdemu advance to the next scanline and deliver
  * IRQ4/HBlank or update device status while the game remains in the same
diff --git a/runner/glue.h b/runner/glue.h
index 78f00b8..1787d81 100644
--- a/runner/glue.h
+++ b/runner/glue.h
@@ -39,6 +39,9 @@ void glue_load_state(FILE *sf);
  * fiber IN PLACE (same engine-owned stack; see fiber_compat.h). Must be
  * called from the scheduler (main) fiber. */
 void glue_restart_game_fiber(uint32_t resume_pc);
+/* Per-frame boundary a game hook may offer for a host snapshot. Returns 1
+ * when the call parked and the snapshot request was serviced. */
+int glue_state_boundary(uint32_t site);
 
 /* Scheduler rule (see glue.c): the same-address spin streak and the Z80
  * sync-poll streak restart at every wall-frame boundary. The tick driver
diff --git a/runner/host_state.h b/runner/host_state.h
index e1b7ea7..5c38bce 100644
--- a/runner/host_state.h
+++ b/runner/host_state.h
@@ -140,6 +140,10 @@ static int host_state_load(const char *path)
     if (!ok) { rewind(backup); host_machine_read(backup); goto done; }
     audio_discard_playback(); /* host payload restored deferred chip events */
     uint32_t pc=g_game_spec.resume_main_loop_pc;
+    if (g_game_spec.state_resume_pc) {
+        uint32_t resume=g_game_spec.state_resume_pc();
+        if (resume) pc=resume;
+    }
     if (g_game_spec.save_resume_pc && g_game_layout.game_mode_addr) {
         uint32_t mapped=g_game_spec.save_resume_pc(glue_peek8(g_game_layout.game_mode_addr));
         if (mapped) pc=mapped;
diff --git a/runner/include/genesis_runtime.h b/runner/include/genesis_runtime.h
index ad17ac9..8ba9579 100644
--- a/runner/include/genesis_runtime.h
+++ b/runner/include/genesis_runtime.h
@@ -129,6 +129,7 @@ int genesis_frame_overdue(void);
 /* ---- Fiber yield (Step 2) ---- */
 void glue_yield_for_vblank(void);
 void glue_yield_for_interrupt_poll(void);
+int glue_state_boundary(uint32_t site);
 
 /* ---- Vectored exceptions (Phase 7A) ----
  * Real semantics for TRAP #N / TRAPV / RTR / RESET / ILLEGAL / A-line /

