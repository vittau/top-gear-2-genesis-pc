+/* ---- Second Z80 bus (race SFX PCM image, BOTH mode) ---------------------- */
+/* Same address map as the canonical Z80 bus, but backed by the second core's
+ * RAM and bank register, and every chip write is tagged AUDIO_ORIGIN_Z80_SFX so
+ * the mixer routes it to virtual chip B. The image polls the YM busy flag, so
+ * its status reads come from chip B's CPU-visible model. */
+uint8_t gbus_z80_sfx_read(GenesisBus *b, uint16_t addr)
+{
+    if (addr < 0x4000u) return b->z80_sfx_ram[addr & 0x1FFFu];
+    if (addr < 0x6000u) {
+        ym_timer_update(&s_ym68k, ym_abs_z80_stamp());
+        return s_ym68k.status;
+    }
+    if (addr < 0x8000u) return 0xFFu;
+    uint32_t a68 = ((uint32_t)b->z80_sfx_bank << 15) + (uint32_t)(addr - 0x8000u);
+    return gbus_read8(b, a68);
+}
+
+void gbus_z80_sfx_write(GenesisBus *b, uint16_t addr, uint8_t val)
+{
+    if (addr < 0x4000u) { unsigned off = addr & 0x1FFFu;
+        if (g_sndwatch[off]) snd_trace_z80((uint16_t)off, val, 1);  /* [SND-TRACE] */
+        b->z80_sfx_ram[off] = val; return; }
+    if (addr < 0x6000u) {
+        uint8_t port = (uint8_t)(addr & 3);
+        ym_write_side_effect(&s_ym68k, port, val, ym_abs_z80_stamp());
+        g_snd_pcz = (unsigned)machine_z80_sfx_pc();
+        audio_event_push_origin(machine_z80_stamp(), port, val,
+                                AUDIO_ORIGIN_Z80_SFX);
+        return;
+    }
+    if (addr < 0x6100u) {
+        b->z80_sfx_bank = ((b->z80_sfx_bank >> 1) | ((val & 1) << 8)) & 0x1FF;
+        return;
+    }
+    if (addr == 0x7F11u) {
+        g_snd_pcz = (unsigned)machine_z80_sfx_pc();
+        audio_event_push_origin(machine_z80_stamp(), AUDIO_PORT_PSG, val,
+                                AUDIO_ORIGIN_Z80_SFX);
+        return;
+    }
+    if (addr >= 0x8000u) {
+        uint32_t a68 = ((uint32_t)b->z80_sfx_bank << 15) +
+                       (uint32_t)(addr - 0x8000u);
+        gbus_write8(b, a68, val);
+    }
+}
