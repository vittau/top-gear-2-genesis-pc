From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Subject: [PATCH] Runtime menu: Quit game row

Enable the recomp-ui standard "Quit game" row (two presses) in the in-game
menu and leave through the normal window-close path, so a controller-only
player (Steam Deck) can exit without the system menu.
---
diff --git a/runner/main.c b/runner/main.c
index 20bdeb3..fc1b7eb 100644
--- a/runner/main.c
+++ b/runner/main.c
@@ -418,6 +418,12 @@ static void runtime_ui_save(void *p) {
 static int runtime_ui_action(void *p, const RecompRuntimeUiItem *i) {
     RuntimeUiContext *c = (RuntimeUiContext *)p;
     if (!strcmp(i->key, RECOMP_RUNTIME_UI_KEY_RESUME)) { recomp_runtime_ui_close(c->ui); return 1; }
+    if (!strcmp(i->key, RECOMP_RUNTIME_UI_KEY_QUIT)) {
+        /* The row already took its confirming second press. Leave through the
+         * same path as closing the window, so settings and SRAM are saved. */
+        SDL_Event quit; memset(&quit, 0, sizeof quit); quit.type = SDL_QUIT;
+        recomp_runtime_ui_close(c->ui); SDL_PushEvent(&quit); return 1;
+    }
     if (g_game_spec.state_size && (!strcmp(i->key,"states.save") || !strcmp(i->key,"states.load"))) {
         char path[32]; snprintf(path,sizeof path,"native_save_%d.bin",s_quickstate_slot);
         int ok=!strcmp(i->key,"states.save")?runner_save_state_file(path):runner_load_state_file(path);
@@ -3176,7 +3182,8 @@ int main(int argc, char *argv[])
         cfg.menu.callbacks.visibility_changed = input_gameplay_capture_changed;
         cfg.features = RECOMP_RUNTIME_UI_STANDARD_FULLSCREEN | RECOMP_RUNTIME_UI_STANDARD_WINDOW_SCALE |
             RECOMP_RUNTIME_UI_STANDARD_VIEW_MODE | RECOMP_RUNTIME_UI_STANDARD_LINEAR_FILTER |
-            RECOMP_RUNTIME_UI_STANDARD_VOLUME | RECOMP_RUNTIME_UI_STANDARD_RESUME;
+            RECOMP_RUNTIME_UI_STANDARD_VOLUME | RECOMP_RUNTIME_UI_STANDARD_RESUME |
+            RECOMP_RUNTIME_UI_STANDARD_QUIT;
         cfg.view_modes = RECOMP_RUNTIME_UI_VIEW_MODE_NATIVE | RECOMP_RUNTIME_UI_VIEW_MODE_FIXED_16_9 |
             RECOMP_RUNTIME_UI_VIEW_MODE_ADAPTIVE;
         if(game_video_has_viewport(g_game_spec.video)) {
