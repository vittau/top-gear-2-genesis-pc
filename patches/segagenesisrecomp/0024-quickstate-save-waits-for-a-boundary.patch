From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Subject: [PATCH] A quickstate asked for between races waits for a boundary

Owner report: at the start of race 4 he saved to slot 1 through the in-game
menu and the file was never written; loading slot 1 later gave the previous
race's state. The save was requested on one of the inter-race screens (race
results, championship table, car/gear setup, next-track intro, shop). Those
screens have no repeatable instruction the host can resume in place: declaring
their frame waits as boundaries makes the save land, but a load of that state
bails out of the race flow to the main menu (the resumed loop's continuation is
a dispatch, not a JSR/BSR chain), so it is not a valid quickstate.

The request now stays queued for up to 15 s of gameplay and is taken at the
next boundary the game does reach: pressing START to begin the next race parks
it at the race loop, so the file holds the start of that race -- exactly what
the menu label promises ("the next completed gameplay tick") and what a player
asking between races wants. The queued state is shown as `SAVING AT NEXT
BOUNDARY...`; if no boundary appears the request is refused with `SAVE
UNAVAILABLE HERE`. A later save request replaces the queued one instead of
being rejected, and a save whose temporary file cannot be created now reports
`SAVE FAILED: CANNOT WRITE STATE` instead of being dropped in silence.
---
diff --git a/runner/host_state.h b/runner/host_state.h
--- a/runner/host_state.h
+++ b/runner/host_state.h
@@ -59,7 +59,10 @@
     if (!ok) { free(host); host_state_notice("SAVE UNAVAILABLE HERE"); fprintf(stderr,"[SAVE] The game adapter cannot save in its current mode.\n"); return 0; }
     char tmp[640]; snprintf(tmp,sizeof tmp,"%s.tmp.%llu",path,(unsigned long long)SDL_GetPerformanceCounter());
     FILE *f=fopen(tmp,"w+b");
-    if (!f) { free(host); return 0; }
+    /* A save that cannot even open its temporary file used to be dropped in
+     * silence (no log line, no notice). Say so: the request is gone. */
+    if (!f) { free(host); host_state_notice("SAVE FAILED: CANNOT WRITE STATE");
+        fprintf(stderr,"[SAVE] cannot create %s\n",tmp); return 0; }
     h.section[0]=(uint32_t)size;
     ok=fwrite(&h,sizeof h,1,f)==1 && fwrite(host,1,size,f)==size && host_machine_write(f,&h);
     free(host);
@@ -89,13 +92,24 @@
 }
 static char host_state_pending[512];
 static unsigned host_state_pending_frames;
+/* How long a save may wait for the game to reach a repeatable boundary. The
+ * inter-race screens (results, championship table, car/gear setup, next-track
+ * intro, shop) have no boundary the host can resume later, so a save asked for
+ * there waits until the player continues into the next race, which is the
+ * moment the menu label promises ("the next completed gameplay tick"). 15 s of
+ * gameplay is enough to press START and reach the race; past that the request
+ * is refused with a visible notice instead of being dropped in silence. */
+#define HOST_STATE_PENDING_FRAMES 900u
 static int host_state_save(const char *path)
 {
-    if (strlen(path)>=sizeof host_state_pending || *host_state_pending) return 0;
-    strcpy(host_state_pending,path); host_state_pending_frames=0;
+    if (strlen(path)>=sizeof host_state_pending) return 0;
+    /* The last request wins: a stale one must never block the menu or the
+     * hotkey, and a second save on the same slot is the same wish. */
+    snprintf(host_state_pending,sizeof host_state_pending,"%s",path);
+    host_state_pending_frames=0;
     glue_state_boundary_request(1);
-    fprintf(stderr,"[SAVE] queued for the next completed gameplay tick: %s\n",path);
-    host_state_notice("SAVING STATE...");
+    fprintf(stderr,"[SAVE] queued for the next resumable gameplay boundary: %s\n",path);
+    host_state_notice("SAVING AT NEXT BOUNDARY...");
     return 1;
 }
 static void host_state_tick(void)
@@ -103,9 +117,10 @@
     if (!*host_state_pending) return;
     if (glue_state_boundary_ready()) {
         host_state_save_now(host_state_pending);
-    } else if (++host_state_pending_frames<120) return;
+    } else if (++host_state_pending_frames<HOST_STATE_PENDING_FRAMES) return;
     else { host_state_notice("SAVE UNAVAILABLE HERE");
-        fprintf(stderr,"[SAVE] no resumable game boundary; previous state retained.\n"); }
+        fprintf(stderr,"[SAVE] no resumable game boundary in %u frames; previous state retained.\n",
+                (unsigned)HOST_STATE_PENDING_FRAMES); }
     host_state_pending[0]=0; glue_state_boundary_request(0);
 }
 static int host_state_load(const char *path)
