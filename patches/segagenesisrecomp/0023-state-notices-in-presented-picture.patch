+static void runner_state_notice(const char *message)
+{
+    snprintf(s_state_notice, sizeof s_state_notice, "%s", message ? message : "");
+    s_state_notice_until = s_state_notice[0] ? SDL_GetTicks() + STATE_NOTICE_MS : 0;
+#if RECOMP_LAUNCHER
+    if (s_runtime_ui.window && s_state_notice[0]) {
+        char title[256];
+        snprintf(title, sizeof title, "%s - %s", g_game_spec.display_name, s_state_notice);
+        SDL_SetWindowTitle(s_runtime_ui.window, title);
+    }
+#endif
+}
+static void runner_state_notice_tick(void)
+{
