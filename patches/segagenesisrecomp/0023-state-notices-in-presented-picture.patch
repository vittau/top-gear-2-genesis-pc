+/* Top-left of the presented picture, in its logical coordinate space, so the
+ * same panel lands correctly in 4:3 and in the 16:9+ canvas at any window
+ * size. Called after the frame (and the runtime menu, if open) is drawn. */
+static void runner_state_notice_present(SDL_Renderer *renderer, int logical_w, int logical_h)
+{
+    if (!renderer || !s_state_notice[0]) return;
+    if (s_state_notice_until && (Sint32)(SDL_GetTicks() - s_state_notice_until) >= 0) return;
+    int scale = logical_h / 224;
+    if (scale < 1) scale = 1;
+    int w = gen_ovl_notice_width(s_state_notice, scale);
+    int h = gen_ovl_notice_height(scale);
+    if (w <= 0 || h <= 0 || w > logical_w || h > logical_h ||
+        (size_t)w * (size_t)h > (size_t)STATE_NOTICE_MAX_PIXELS) return;
+    if (!s_state_notice_tex || strcmp(s_state_notice_tex_text, s_state_notice) ||
+        s_state_notice_tex_w != w || s_state_notice_tex_h != h ||
+        s_state_notice_tex_scale != scale) {
+        if (s_state_notice_tex) {
+            SDL_DestroyTexture(s_state_notice_tex);
+            s_state_notice_tex = NULL;
+        }
+        s_state_notice_tex = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ARGB8888,
+                                               SDL_TEXTUREACCESS_STREAMING, w, h);
+        if (!s_state_notice_tex) return;
+        SDL_SetTextureBlendMode(s_state_notice_tex, SDL_BLENDMODE_BLEND);
+        SDL_SetTextureScaleMode(s_state_notice_tex, SDL_ScaleModeNearest);
+        memset(s_state_notice_pixels, 0, (size_t)w * (size_t)h * sizeof(uint32_t));
+        gen_ovl_notice(s_state_notice_pixels, w, h, 0, 0, scale, s_state_notice);
+        if (SDL_UpdateTexture(s_state_notice_tex, NULL, s_state_notice_pixels,
+                              w * (int)sizeof(uint32_t)) != 0) {
+            SDL_DestroyTexture(s_state_notice_tex);
+            s_state_notice_tex = NULL;
+            return;
+        }
+        snprintf(s_state_notice_tex_text, sizeof s_state_notice_tex_text, "%s", s_state_notice);
+        s_state_notice_tex_w = w;
+        s_state_notice_tex_h = h;
+        s_state_notice_tex_scale = scale;
+    }
+    int margin = 6 * scale;
+    SDL_Rect dst = { margin, margin, w, h };
+    SDL_RenderCopy(renderer, s_state_notice_tex, NULL, &dst);
+}
+/* Logical canvas currently presented (widescreen canvas or the native frame). */
+static void runner_state_notice_present_here(SDL_Renderer *renderer)
+{
+    int w = ws_armed() ? ws_canvas_w() : s_screen_width;
+    int h = ws_armed() ? ws_canvas_h() : display_logical_height();
+    runner_state_notice_present(renderer, w, h);
+}
