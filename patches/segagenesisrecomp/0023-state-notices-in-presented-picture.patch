+static void handle_pad(int id)
+{
+    extern int input_gameplay_blocked(void);
+    char buf[160];
+    snprintf(buf, sizeof buf,
+             "{\"id\":%d,\"ok\":true,\"pad0\":%d,\"pad1\":%d,\"blocked\":%d}",
+             id, runner_debug_pad_mask(0), runner_debug_pad_mask(1), input_gameplay_blocked());
