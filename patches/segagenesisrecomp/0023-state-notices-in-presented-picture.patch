+/* Dev-only: the runner's own input seam, so a headless probe can drive the
+ * runtime menu and the quickstate hotkeys with real SDL key events and the
+ * held-key state they imply. {"key":"return","down":1,"shift":0} */
+extern int runner_debug_key(const char *name, int down, int shift);
+extern int runner_debug_ui_open(const char *section);
+extern int runner_debug_ui_row_count(void);
+extern int runner_debug_ui_row(int index, char *label, size_t label_cap,
+                               char *value, size_t value_cap, int *selected);
+
+static void handle_key(int id, const char *json)
+{
+    char name[24] = {0};
+    if (!json_get_str(json, "name", name, sizeof(name))) {
+        send_err(id, "missing name");
+        return;
+    }
+    /* "held":1 (default) presses; 0 releases. Spelled "held" so the value of
+     * "name" ("down", "up") can never be matched as a JSON key. */
+    int down = json_get_int(json, "held", 1);
+    int shift = json_get_int(json, "shift", 0);
+    if (runner_debug_key(name, down, shift)) send_ok(id);
+    else send_err(id, "unknown key (return escape space tab up down left right f1..f9)");
+}
+
+static void handle_ui_open(int id, const char *json)
+{
+    char section[64] = {0};
+    json_get_str(json, "section", section, sizeof(section));
+    if (runner_debug_ui_open(section[0] ? section : NULL)) send_ok(id);
+    else send_err(id, "runtime menu unavailable or unknown section");
+}
