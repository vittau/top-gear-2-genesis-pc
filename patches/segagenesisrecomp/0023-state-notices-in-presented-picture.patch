+/* Capture of the presented window itself (renderer target), which is the only
+ * place host overlays such as the state notice exist. Explicitly separate from
+ * runner_write_screenshot_file so every probe/test capture stays the verified
+ * guest framebuffer unless it asks for the presented picture. */
+int runner_write_presented_screenshot_file(const char *path)
+{
+    char full_path[512];
+    const char *resolved = resolve_runner_path(path, full_path, sizeof(full_path));
+    SDL_Renderer *renderer = s_video_renderer;
+    int w = 0, h = 0;
+    if (!renderer || SDL_GetRendererOutputSize(renderer, &w, &h) != 0 ||
+        w <= 0 || h <= 0 || w > 8192 || h > 8192) {
+        fprintf(stderr, "[SCREENSHOT] presented capture unavailable\n");
+        return 0;
+    }
+    uint32_t *pixels = (uint32_t *)calloc((size_t)w * (size_t)h, sizeof(uint32_t));
+    if (!pixels) return 0;
+    /* SDL reads only the logical viewport (the letterboxed picture), so clear
+     * the whole window first and read into the viewport's own offset. */
+    int pitch = w * (int)sizeof(uint32_t);
+    SDL_Rect viewport;
+    SDL_RenderGetViewport(renderer, &viewport);
+    uint8_t *dst = (uint8_t *)pixels + (size_t)viewport.y * (size_t)pitch +
+                   (size_t)viewport.x * sizeof(uint32_t);
+    int ok = SDL_RenderReadPixels(renderer, NULL, SDL_PIXELFORMAT_ARGB8888,
+                                  dst, pitch) == 0 &&
+             png_write_argb(resolved, pixels, w, h, w) == 0;
+    free(pixels);
+    if (ok) fprintf(stderr, "[SCREENSHOT] presented %dx%d -> %s\n", w, h, resolved);
+    else fprintf(stderr, "[SCREENSHOT] presented capture failed for %s\n", resolved);
+    return ok;
+}
