+/* Host notice text: the in-game runtime menu's own 5x7 cell, so a save/load
+ * message matches the ESC menu's typography. `scale` multiplies whole pixels. */
+int gen_ovl_text5x7_width(const char *text, int scale);
+void gen_ovl_draw_text5x7(uint32_t *dst, int stride, int height,
+                          int x, int y, const char *text, uint32_t color,
+                          int scale);
+
+/* A complete notice panel (dim genesis-theme backing, azure edge, shadowed
+ * light text) drawn at (x,y) in a fresh ARGB buffer. */
+int gen_ovl_notice_width(const char *text, int scale);
+int gen_ovl_notice_height(int scale);
+void gen_ovl_notice(uint32_t *dst, int stride, int height,
+                    int x, int y, int scale, const char *text);
+
 #endif
