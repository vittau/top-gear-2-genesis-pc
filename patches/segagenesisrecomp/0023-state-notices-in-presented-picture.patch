From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Subject: [PATCH] Save/load feedback drawn in the presented picture

A quickstate save or load only reported itself by rewriting the window title
for a few seconds, which is invisible in fullscreen, on a Steam Deck, or when
the title bar is out of view. The player could not tell a save from a refusal.

The host now draws a short notice at the top-left of the presented picture for
2.5 s: STATE SAVED TO SLOT N, STATE LOADED FROM SLOT N, SAVING STATE...,
SAVE UNAVAILABLE HERE, SAVE FAILED, LOAD REJECTED. It uses the in-game runtime
menu's own 5x7 cell and light text colour over a dim genesis-theme panel with a
shadow, so it reads as that menu and stays legible over any race picture. The
title still changes.

The notice is a presentation overlay: it is drawn after the guest frame is
composited and never enters the guest, the framebuffer hashes, a replay, or a
captured game frame. `screenshot` with "presented":1 captures the composited
window for evidence that a test may want; the default capture stays the
verified guest framebuffer.

Dev builds also gain the probes that drive the real menu over TCP (`key`,
`ui_open`, `ui_rows`, `pad`), because SDL_GetKeyboardState cannot be set from
outside the process.
---
diff --git a/runner/overlay_draw.c b/runner/overlay_draw.c
--- a/runner/overlay_draw.c
+++ b/runner/overlay_draw.c
@@ -93,3 +93,140 @@
         x += 8 * scale;
     }
 }
+
+/* ── 5x7 glyphs, byte-identical to the in-game runtime menu ────────────────
+ * The ESC menu composites through recomp-ui's software presentation, whose
+ * text is this 5x7 cell (MIT, recomp-ui src/common/recomp_runtime_ui.c:
+ * glyph_bits). A host notice drawn with the same cells and the theme's light
+ * text colour reads as part of that menu instead of a second UI font. */
+#define OVL_GLYPH(a,b,c,d,e,f,g) \
+    ((uint64_t)(a) | ((uint64_t)(b) << 5) | ((uint64_t)(c) << 10) | \
+     ((uint64_t)(d) << 15) | ((uint64_t)(e) << 20) | \
+     ((uint64_t)(f) << 25) | ((uint64_t)(g) << 30))
+static uint64_t ovl_glyph5x7(unsigned char c)
+{
+    if (c >= 'a' && c <= 'z') c = (unsigned char)(c - 'a' + 'A');
+    switch (c) {
+    case 'A': return OVL_GLYPH(14,17,17,31,17,17,17);
+    case 'B': return OVL_GLYPH(30,17,17,30,17,17,30);
+    case 'C': return OVL_GLYPH(14,17,16,16,16,17,14);
+    case 'D': return OVL_GLYPH(30,17,17,17,17,17,30);
+    case 'E': return OVL_GLYPH(31,16,16,30,16,16,31);
+    case 'F': return OVL_GLYPH(31,16,16,30,16,16,16);
+    case 'G': return OVL_GLYPH(14,17,16,23,17,17,15);
+    case 'H': return OVL_GLYPH(17,17,17,31,17,17,17);
+    case 'I': return OVL_GLYPH(14,4,4,4,4,4,14);
+    case 'J': return OVL_GLYPH(7,2,2,2,18,18,12);
+    case 'K': return OVL_GLYPH(17,18,20,24,20,18,17);
+    case 'L': return OVL_GLYPH(16,16,16,16,16,16,31);
+    case 'M': return OVL_GLYPH(17,27,21,21,17,17,17);
+    case 'N': return OVL_GLYPH(17,25,21,19,17,17,17);
+    case 'O': return OVL_GLYPH(14,17,17,17,17,17,14);
+    case 'P': return OVL_GLYPH(30,17,17,30,16,16,16);
+    case 'Q': return OVL_GLYPH(14,17,17,17,21,18,13);
+    case 'R': return OVL_GLYPH(30,17,17,30,20,18,17);
+    case 'S': return OVL_GLYPH(15,16,16,14,1,1,30);
+    case 'T': return OVL_GLYPH(31,4,4,4,4,4,4);
+    case 'U': return OVL_GLYPH(17,17,17,17,17,17,14);
+    case 'V': return OVL_GLYPH(17,17,17,17,17,10,4);
+    case 'W': return OVL_GLYPH(17,17,17,21,21,21,10);
+    case 'X': return OVL_GLYPH(17,17,10,4,10,17,17);
+    case 'Y': return OVL_GLYPH(17,17,10,4,4,4,4);
+    case 'Z': return OVL_GLYPH(31,1,2,4,8,16,31);
+    case '0': return OVL_GLYPH(14,17,19,21,25,17,14);
+    case '1': return OVL_GLYPH(4,12,4,4,4,4,14);
+    case '2': return OVL_GLYPH(14,17,1,2,4,8,31);
+    case '3': return OVL_GLYPH(30,1,1,14,1,1,30);
+    case '4': return OVL_GLYPH(2,6,10,18,31,2,2);
+    case '5': return OVL_GLYPH(31,16,16,30,1,1,30);
+    case '6': return OVL_GLYPH(14,16,16,30,17,17,14);
+    case '7': return OVL_GLYPH(31,1,2,4,8,8,8);
+    case '8': return OVL_GLYPH(14,17,17,14,17,17,14);
+    case '9': return OVL_GLYPH(14,17,17,15,1,1,14);
+    case '-': return OVL_GLYPH(0,0,0,31,0,0,0);
+    case '+': return OVL_GLYPH(0,4,4,31,4,4,0);
+    case '/': return OVL_GLYPH(1,2,2,4,8,8,16);
+    case ':': return OVL_GLYPH(0,4,4,0,4,4,0);
+    case '.': return OVL_GLYPH(0,0,0,0,0,6,6);
+    case ',': return OVL_GLYPH(0,0,0,0,6,6,4);
+    case '(': return OVL_GLYPH(2,4,8,8,8,4,2);
+    case ')': return OVL_GLYPH(8,4,2,2,2,4,8);
+    case '[': return OVL_GLYPH(14,8,8,8,8,8,14);
+    case ']': return OVL_GLYPH(14,2,2,2,2,2,14);
+    case '%': return OVL_GLYPH(17,2,4,4,8,16,17);
+    case '<': return OVL_GLYPH(2,4,8,16,8,4,2);
+    case '>': return OVL_GLYPH(8,4,2,1,2,4,8);
+    case '=': return OVL_GLYPH(0,0,31,0,31,0,0);
+    case '_': return OVL_GLYPH(0,0,0,0,0,0,31);
+    case '!': return OVL_GLYPH(4,4,4,4,4,0,4);
+    case '?': return OVL_GLYPH(14,17,1,2,4,0,4);
+    case '#': return OVL_GLYPH(10,31,10,10,31,10,0);
+    case '\'': return OVL_GLYPH(4,4,2,0,0,0,0);
+    case ' ': return 0;
+    default: return OVL_GLYPH(14,17,2,4,4,0,4);
+    }
+}
+#undef OVL_GLYPH
+
+/* One 5x7 cell is 6 px wide including its column gap, 7 px tall. */
+int gen_ovl_text5x7_width(const char *s, int scale)
+{
+    int n = 0;
+    if (!s) return 0;
+    for (const unsigned char *p = (const unsigned char *)s; *p; ++p)
+        if (*p < 0x80) ++n;
+    if (scale < 1) scale = 1;
+    return n * 6 * scale;
+}
+
+void gen_ovl_draw_text5x7(uint32_t *dst, int stride, int h_max,
+                          int x, int y, const char *s, uint32_t col, int scale)
+{
+    if (!s || !dst) return;
+    if (scale < 1) scale = 1;
+    int cursor = x;
+    for (const unsigned char *p = (const unsigned char *)s; *p; ++p) {
+        if (*p >= 0x80) continue;
+        uint64_t bits = ovl_glyph5x7(*p);
+        for (int gy = 0; gy < 7; ++gy) {
+            unsigned row = (unsigned)((bits >> (gy * 5)) & 31);
+            for (int gx = 0; gx < 5; ++gx) {
+                if ((row & (1u << (4 - gx))) == 0) continue;
+                for (int sy = 0; sy < scale; ++sy)
+                    for (int sx = 0; sx < scale; ++sx) {
+                        int dx = cursor + gx * scale + sx;
+                        int dy = y + gy * scale + sy;
+                        if (dx >= 0 && dx < stride && dy >= 0 && dy < h_max)
+                            dst[dy * stride + dx] = col;
+                    }
+            }
+        }
+        cursor += 6 * scale;
+    }
+}
+
+/* Notice panel geometry: accent edge, margins, then the text cell. */
+int gen_ovl_notice_width(const char *s, int scale)
+{ return gen_ovl_text5x7_width(s, scale) + 10 * (scale < 1 ? 1 : scale); }
+int gen_ovl_notice_height(int scale)
+{ return 7 * (scale < 1 ? 1 : scale) + 8 * (scale < 1 ? 1 : scale); }
+
+/* Draws the whole notice (dim backing, shadow, light text) into a fresh
+ * ARGB buffer: x,y are the panel's top-left corner, (stride,h_max) bound the
+ * destination. Colours mirror the in-game menu's genesis theme: panel
+ * #111826, light text #E9EDF5, Sega-azure edge. The shadow keeps it readable
+ * over a bright race picture. */
+void gen_ovl_notice(uint32_t *dst, int stride, int h_max, int x, int y,
+                    int scale, const char *s)
+{
+    if (!dst || !s) return;
+    if (scale < 1) scale = 1;
+    int w = gen_ovl_notice_width(s, scale);
+    int h = gen_ovl_notice_height(scale);
+    gen_ovl_fill_rect(dst, stride, h_max, x, y, w, h, 0xE0111826u);
+    gen_ovl_fill_rect(dst, stride, h_max, x, y, 2 * scale, h, 0xFF17A2E6u);
+    gen_ovl_draw_text5x7(dst, stride, h_max, x + 6 * scale + scale, y + 4 * scale + scale,
+                         s, 0x90000000u, scale);          /* shadow */
+    gen_ovl_draw_text5x7(dst, stride, h_max, x + 6 * scale, y + 4 * scale,
+                         s, 0xFFE9EDF5u, scale);          /* light text */
+}
