+/* Dev/TCP hooks that let a headless probe drive the runtime menu and the
+ * quickstate hotkeys with real SDL key events (the same ones a player
+ * generates) instead of reaching into the UI model. The matching held-key
+ * state goes through input_map's dev seam because SDL_GetKeyboardState cannot
+ * be set from outside SDL; both are development/test paths only. */
+int runner_debug_key(const char *name, int down, int shift)
+{
+    static const struct { const char *name; SDL_Keycode sym; SDL_Scancode sc; } keys[] = {
+        { "return", SDLK_RETURN, SDL_SCANCODE_RETURN },
+        { "escape", SDLK_ESCAPE, SDL_SCANCODE_ESCAPE },
+        { "space",  SDLK_SPACE,  SDL_SCANCODE_SPACE  },
+        { "tab",    SDLK_TAB,    SDL_SCANCODE_TAB    },
+        { "up",     SDLK_UP,     SDL_SCANCODE_UP     },
+        { "down",   SDLK_DOWN,   SDL_SCANCODE_DOWN   },
+        { "left",   SDLK_LEFT,   SDL_SCANCODE_LEFT   },
+        { "right",  SDLK_RIGHT,  SDL_SCANCODE_RIGHT  },
+        { "f1", SDLK_F1, SDL_SCANCODE_F1 }, { "f2", SDLK_F2, SDL_SCANCODE_F2 },
+        { "f3", SDLK_F3, SDL_SCANCODE_F3 }, { "f4", SDLK_F4, SDL_SCANCODE_F4 },
+        { "f5", SDLK_F5, SDL_SCANCODE_F5 }, { "f6", SDLK_F6, SDL_SCANCODE_F6 },
+        { "f7", SDLK_F7, SDL_SCANCODE_F7 }, { "f8", SDLK_F8, SDL_SCANCODE_F8 },
+        { "f9", SDLK_F9, SDL_SCANCODE_F9 },
+    };
+    for (unsigned i = 0; i < sizeof keys / sizeof keys[0]; ++i) {
+        if (strcmp(name, keys[i].name) != 0) continue;
+        SDL_Event ev;
+        memset(&ev, 0, sizeof ev);
+        ev.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+        ev.key.type = ev.type;
+        ev.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+        ev.key.repeat = 0;
+        ev.key.keysym.sym = keys[i].sym;
+        ev.key.keysym.scancode = keys[i].sc;
+        ev.key.keysym.mod = shift ? KMOD_SHIFT : KMOD_NONE;
+        SDL_PushEvent(&ev);
+        input_test_key_hold((int)keys[i].sc, down);
+        return 1;
+    }
+    return 0;
+}
