From 8245934ddd69958c40a8928817e8eebfda0013a4 Mon Sep 17 00:00:00 2001
From: Vitor Machado <2932830+vittau@users.noreply.github.com>
Date: Thu, 12 Nov 2026 10:52:20 -0300
Subject: [PATCH] Make replay and execution diagnostics opt in

Migrate the old diagnostics default and let release users enable replay/evidence for bug reports without normal-play files.
---
 runner/app_config.c        | 39 ++++++++++++++++++++++++++++++---
 runner/app_config.h        | 20 ++++++++++++++++-
 runner/diagnostic_replay.c |  5 +++--
 runner/main.c              | 44 +++++++++++++++++++++++++++++++++++++-
 runner/runtime_evidence.c  | 16 +++++++++++++-
 runner/runtime_evidence.h  | 10 ++++++++-
 6 files changed, 125 insertions(+), 9 deletions(-)

diff --git a/runner/app_config.c b/runner/app_config.c
index 041453b..652f770 100644
--- a/runner/app_config.c
+++ b/runner/app_config.c
@@ -45,7 +45,22 @@ void app_config_defaults(void)
     g_app_config.rewind_enabled   = 1;
     g_app_config.rewind_depth     = 60;
     g_app_config.rewind_interval  = 6;
-    g_app_config.replay_diagnostics = 1;
+    g_app_config.replay_diagnostics = 0;
+}
+
+/* ---- settings version / migration --------------------------------------- */
+
+static int s_settings_version;   /* [meta] settings_version; 0 = pre-task-32 */
+static int s_migrated;           /* the file just read needs a rewrite        */
+
+int app_config_migrated(void) { return s_migrated; }
+
+/* --debug: diagnostics for this process only, never persisted. */
+static int s_debug_diagnostics;
+void app_config_set_debug_diagnostics(int on) { s_debug_diagnostics = on != 0; }
+int app_config_diagnostics_active(void)
+{
+    return g_app_config.replay_diagnostics || s_debug_diagnostics;
 }
 
 /* ---- tiny ini helpers ---------------------------------------------------- */
@@ -96,6 +111,8 @@ static void format_pad_bind(const GamepadBind *b, char *out, size_t n)
 
 int app_config_load(const char *path)
 {
+    s_migrated = 0;
+    s_settings_version = 0;
     FILE *f = fopen(path, "rb");
     if (!f) return 0;
 
@@ -117,6 +134,7 @@ int app_config_load(const char *path)
             else if (!strcmp(name, "mods.widescreen")) section = 3;
             else if (!strcmp(name, "rewind"))   section = 4;
             else if (!strcmp(name, "mods.diagnostics")) section = 5;
+            else if (!strcmp(name, "meta"))       section = 6;
             else if (!strcmp(name, "input.p1")) section = 10;
             else if (!strcmp(name, "input.p2")) section = 11;
             else if (!strcmp(name, "input.p3")) section = 12;
@@ -172,6 +190,8 @@ int app_config_load(const char *path)
             else if (!strcmp(key, "interval")) g_app_config.rewind_interval = atoi(val);
         } else if (section == 5) {
             if (!strcmp(key,"enabled")) g_app_config.replay_diagnostics=atoi(val)!=0;
+        } else if (section == 6) {
+            if (!strcmp(key,"settings_version")) s_settings_version=atoi(val);
         } else if (section >= 10 && section < 10 + INPUT_MAX_PLAYERS) {
             PlayerInput *pi = &g_input_map.p[section - 10];
             if      (!strcmp(key, "device"))   pi->device       = atoi(val);
@@ -187,6 +207,18 @@ int app_config_load(const char *path)
         }
     }
     fclose(f);
+    /* Task 32 migration. A version-1 settings.ini wrote
+     * `[mods.diagnostics] enabled = 1` because that was the DEFAULT (the
+     * Diagnostics mod was on for everybody), not because the player chose it.
+     * Diagnostics are opt-in from version 2 on: force them off here and let
+     * the caller rewrite the file once (app_config_migrated()). A version-2
+     * file keeps exactly what it saved, so a deliberate enable survives. */
+    if (s_settings_version < APP_CONFIG_SETTINGS_VERSION) {
+        s_migrated = 1;
+        if (g_app_config.replay_diagnostics)
+            fprintf(stderr, "[config] migrating settings.ini: diagnostics are now opt-in\n");
+        g_app_config.replay_diagnostics = 0;
+    }
     return 1;
 }
 
@@ -225,6 +257,7 @@ int app_config_save(const char *path)
 
     fprintf(f, "# segagenesisrecomp launcher settings. Edited by the launcher;\n"
                "# hand-editable. SDL scancodes are numeric (see SDL_scancode.h).\n\n");
+    fprintf(f, "[meta]\nsettings_version = %d\n\n", APP_CONFIG_SETTINGS_VERSION);
     fprintf(f, "[video]\n");
     fprintf(f, "window_scale = %d\n",     g_app_config.window_scale);
     fprintf(f, "fullscreen = %d\n",       g_app_config.fullscreen);
@@ -315,7 +348,7 @@ static int video_mod_package(void *ctx,int i,RecompLauncherCModPackage *out)
     if(i==s_mod_video_available) {
         MOD_COPY(out->id,"playtest-diagnostics");MOD_COPY(out->name,"Playtest Diagnostics");MOD_COPY(out->version,"1");
         MOD_COPY(out->author,"GenesisRecomp contributors");MOD_COPY(out->license,"PolyForm Noncommercial 1.0.0");
-        MOD_COPY(out->description,"Automatically record replayable bug reports in logs. Attach the replay and its sidecars when reporting a problem.");
+        MOD_COPY(out->description,"Off for normal play. When enabled, records a replayable bug report in logs; attach the replay and its sidecars when reporting a problem.");
         out->enabled=g_app_config.replay_diagnostics;return 1;
     }
     MOD_COPY(out->id,"custom-widescreen");MOD_COPY(out->name,"Widescreen");MOD_COPY(out->version,"1");
@@ -345,7 +378,7 @@ static int video_mod_feature(void *ctx,int i,RecompLauncherCModFeature *out)
         MOD_COPY(out->package_name,"Playtest Diagnostics");MOD_COPY(out->package_version,"1");
         MOD_COPY(out->name,"Replayable feedback");MOD_COPY(out->group,"Diagnostics");
         MOD_COPY(out->author,"GenesisRecomp contributors");
-        MOD_COPY(out->description,"Default on. Records controller inputs, settings, mods and state checks for offline reproduction. Zip the game's feedback replay and all sidecars from logs after a problem.");
+        MOD_COPY(out->description,"Off by default (or with --debug). Records controller inputs, settings, mods and state checks for offline reproduction. Zip the game's feedback replay and all sidecars from logs after a problem.");
         MOD_COPY(out->status,g_app_config.replay_diagnostics?"Recording on next launch":"Disabled");
         out->enabled=g_app_config.replay_diagnostics;return 1;
     }
diff --git a/runner/app_config.h b/runner/app_config.h
index 1497648..1361b95 100644
--- a/runner/app_config.h
+++ b/runner/app_config.h
@@ -38,11 +38,22 @@ typedef struct AppConfig {
     int rewind_enabled;     /* local rewind; never available in netplay */
     int rewind_depth;       /* snapshot slots */
     int rewind_interval;    /* guest frames between snapshots */
-    int replay_diagnostics; /* default-on replayable player feedback */
+    int replay_diagnostics; /* opt-in replayable player feedback (--debug) */
 } AppConfig;
 
+/* settings.ini schema version, stamped as [meta] settings_version. Version 2
+ * (task 32) made the feedback replay/diagnostics opt-in; a version-1 file
+ * saved `[mods.diagnostics] enabled = 1` as the old default, so it must load
+ * with diagnostics off and be rewritten once. */
+#define APP_CONFIG_SETTINGS_VERSION 2
+
 extern AppConfig g_app_config;
 
+/* 1 when the settings.ini just read predates APP_CONFIG_SETTINGS_VERSION and
+ * still has to be rewritten (diagnostics already forced off). Cleared by the
+ * next app_config_load(); 0 when the file is missing or current. */
+int  app_config_migrated(void);
+
 /* Reset g_app_config to defaults (does NOT touch g_input_map). */
 void app_config_defaults(void);
 
@@ -62,6 +73,13 @@ void app_config_reload_preserving_mods(const char *path);
  * success. */
 int  app_config_save(const char *path);
 
+/* Process-scoped diagnostics (`--debug`). The feedback replay records when
+ * either the saved Diagnostics option or this flag is set; the flag is never
+ * written back to settings.ini, so a debug launch cannot leave a normal
+ * install recording replays. */
+void app_config_set_debug_diagnostics(int on);
+int  app_config_diagnostics_active(void);
+
 struct GameVideo;
 struct RecompLauncherCModProvider;
 const char *app_config_aspect_mode(int aspect);
diff --git a/runner/diagnostic_replay.c b/runner/diagnostic_replay.c
index 5588ac2..01e8bce 100644
--- a/runner/diagnostic_replay.c
+++ b/runner/diagnostic_replay.c
@@ -385,7 +385,8 @@ int genesis_replay_init(const char *directory, const char *playback,
     return 1;
   }
   const char *record = getenv("GENESIS_REPLAY_RECORD");
-  if (!g_app_config.replay_diagnostics || (record && !strcmp(record, "0")))
+  /* Off for normal play; the Diagnostics option or `--debug` records. */
+  if (!app_config_diagnostics_active() || (record && !strcmp(record, "0")))
     return 1;
   char logs[1200];
   snprintf(logs, sizeof logs, "%s/logs", folder);
@@ -435,7 +436,7 @@ int genesis_replay_init(const char *directory, const char *playback,
     free(context);
   }
   fprintf(stderr,
-          "[feedback-replay] %s (default on; attach replay and all sidecars)\n",
+          "[feedback-replay] %s (diagnostics on; attach the replay and all sidecars)\n",
           path);
   return 1;
 }
diff --git a/runner/main.c b/runner/main.c
index 0ae05a7..281a24e 100644
--- a/runner/main.c
+++ b/runner/main.c
@@ -327,6 +327,10 @@ int runner_load_state_file(const char *path);
 static const char *const s_presentation_rates[]={"Off (original rate)","120 Hz","144 Hz","Display refresh rate"};
 static const RecompRuntimeUiItem s_presentation_item={"video.presentation_rate","Mods","High refresh rate","Smooth camera and actors between original ticks; one tick of visual latency. Game and audio speed stay unchanged.",RECOMP_RUNTIME_UI_CHOICE,0,3,1,s_presentation_rates,4};
 static const RecompRuntimeUiItem s_audio_filter_item={"audio.bypass_filter","Audio","Unfiltered audio","Bypass native hardware low-pass filters. A separate enhanced FM path retains its own sound.",RECOMP_RUNTIME_UI_BOOL,0,1,1};
+/* Task 32: the Diagnostics mod is opt-in. A controller-only Deck player turns
+ * it on here (or in the launcher's Mods page) before reproducing a problem on
+ * the next launch; nothing is recorded while it stays off. */
+static const RecompRuntimeUiItem s_diagnostics_item={"mods.diagnostics.enabled","Mods","Diagnostics (bug report)","Records a replay of this session under logs/ for a bug report. Off for normal play. On takes effect next launch: turn it on, restart, reproduce the problem, then attach the logs folder.",RECOMP_RUNTIME_UI_BOOL,0,1,1};
 static const char *const s_mod_aspects[]={"Adaptive","16:9","21:9","32:9"};
 static const int s_hd_scales[]={1,2,4,8,16,32,64};
 static const char *const s_hd_labels[]={"Native","2x","4x","8x","16x","32x","64x"};
@@ -357,6 +361,7 @@ static int runtime_ui_get(void *p, const RecompRuntimeUiItem *i, int *out) {
     else if (!strcmp(i->key,"mods.widescreen.aspect")) *out = g_app_config.custom_aspect;
     else if (!strcmp(i->key,"video.presentation_rate")) *out=app_config_presentation_index(g_app_config.presentation_rate);
     else if (!strcmp(i->key,"audio.bypass_filter")) *out=g_app_config.audio_filter_bypass;
+    else if (!strcmp(i->key,"mods.diagnostics.enabled")) *out=g_app_config.replay_diagnostics;
     else if (!strcmp(i->key,"states.slot")) *out = s_quickstate_slot;
     else if (!strcmp(i->key,"video.internal_resolution")) {
         *out=0;for(int n=0;n<7;++n)if(s_hd_scales[n]==g_app_config.internal_scale)*out=n;
@@ -374,6 +379,11 @@ static int runtime_ui_set(void *p, const RecompRuntimeUiItem *i, int v) {
     if(!strcmp(i->key,"audio.bypass_filter")) {
         g_app_config.audio_filter_bypass=v!=0;audio_mixer_set_filter_bypass(v);return 1;
     }
+    if(!strcmp(i->key,"mods.diagnostics.enabled")) {
+        /* Persisted in [mods.diagnostics] by this menu's save; the replay
+         * starts on the next launch (genesis_replay_init runs at boot). */
+        g_app_config.replay_diagnostics=v!=0;return 1;
+    }
     if(!strcmp(i->key,"video.presentation_rate")) {
         if(v<0 || v>3 || !g_game_spec.video || !g_game_spec.video->interpolate)return 0;
         g_app_config.presentation_rate=app_config_presentation_rate(v);
@@ -3098,6 +3108,11 @@ int main(int argc, char *argv[])
         yield_log = v && v[0] && v[0] != '0';
     }
 
+    /* --debug: turn the opt-in diagnostics on for this launch. Applied after
+     * settings.ini is read (so it wins over the saved Diagnostics option) and
+     * never written back. */
+    int debug_cli = 0;
+
     for (int i = 1; i < argc; i++) {
         if (strcmp(argv[i], "--max-frames") == 0 && i + 1 < argc) {
             max_frames = (uint32_t)atol(argv[++i]);
@@ -3182,6 +3197,10 @@ int main(int argc, char *argv[])
             exec_cov_out = argv[++i];
         } else if (strcmp(argv[i], "--yield-log") == 0) {
             yield_log = 1;
+        } else if (strcmp(argv[i], "--debug") == 0) {
+            /* Opt-in diagnostics for a bug report: the feedback replay and the
+             * runtime evidence manifests for THIS launch (never persisted). */
+            debug_cli = 1;
         } else if (strcmp(argv[i], "--fresh-evidence") == 0) {
             /* Start dispatch_misses.toml & co. empty for this launch (the
              * previous contents move to <name>.prev.toml). Default: evidence
@@ -3405,6 +3424,28 @@ int main(int argc, char *argv[])
 #endif
     }
 
+    /* ---- Session diagnostics (task 32) -----------------------------------
+     * Normal play writes no logs. The feedback replay and the runtime evidence
+     * manifests are opt-in: `--debug` turns them on for this launch, and the
+     * Diagnostics row in the launcher/Esc menu persists the same choice in
+     * settings.ini for the next one. */
+    if (debug_cli) {
+        app_config_set_debug_diagnostics(1);
+        runtime_evidence_set_enabled(1);
+        fprintf(stderr, "[diagnostics] --debug: feedback replay and runtime evidence on\n");
+    }
+    /* A settings.ini written by a pre-task-32 build saved
+     * `[mods.diagnostics] enabled = 1` as the old DEFAULT. app_config_load()
+     * already forced it off and flagged the file; stamp the new version once
+     * so a later deliberate enable survives. */
+    if (app_config_migrated()) {
+        if (runner_save_settings(settings_ini))
+            fprintf(stderr, "[config] settings.ini migrated to version %d (diagnostics opt-in)\n",
+                    APP_CONFIG_SETTINGS_VERSION);
+        else
+            fprintf(stderr, "[config] could not rewrite %s during migration\n", settings_ini);
+    }
+
     if (!rom_path) {
 #ifdef _WIN32
         static char picked_path[512] = {0};
@@ -3809,13 +3850,14 @@ int main(int argc, char *argv[])
             cfg.features &= ~RECOMP_RUNTIME_UI_STANDARD_VIEW_MODE;
         }
         {
-            static RecompRuntimeUiItem items[16]; unsigned count=0;
+            static RecompRuntimeUiItem items[20]; unsigned count=0;
             if (game_video_has_viewport(g_game_spec.video)) {
                 memcpy(items,s_video_mod_items,sizeof s_video_mod_items); count=2;
             }
             if(g_game_spec.video && g_game_spec.video->interpolate)
                 items[count++]=s_presentation_item;
             items[count++]=s_audio_filter_item;
+            items[count++]=s_diagnostics_item;
             memcpy(items+count,s_hd_items,sizeof s_hd_items);++count;
             if (!g_game_spec.state_unavailable_reason || !g_game_spec.state_unavailable_reason()) {
                 memcpy(items+count,s_quickstate_items,sizeof s_quickstate_items);count+=3;
diff --git a/runner/runtime_evidence.c b/runner/runtime_evidence.c
index d0cd3cf..a5cc89e 100644
--- a/runner/runtime_evidence.c
+++ b/runner/runtime_evidence.c
@@ -553,12 +553,25 @@ static void load_one(EvFile *f)
 
 void runtime_evidence_request_fresh(void) { s_fresh = 1; }
 
+/* Evidence manifests are development artifacts: a trace build (the default
+ * for tools/build-linux.sh) keeps writing them, a release build writes
+ * nothing unless --debug asked for them. */
+#if GEN_ENABLE_TRACE
+#define RT_EVIDENCE_BUILD_DEFAULT 1
+#else
+#define RT_EVIDENCE_BUILD_DEFAULT 0
+#endif
+static int s_enabled = -1;   /* -1 = build default, 0 off, 1 on */
+
+void runtime_evidence_set_enabled(int on) { s_enabled = on != 0; }
+
 static void evidence_atexit(void) { runtime_evidence_flush(); }
 
 void runtime_evidence_init(const char *game_short_name, const char *game_display_name,
                            const uint8_t *rom, size_t rom_len)
 {
-    if (s_inited) return;
+    if (s_enabled < 0) s_enabled = RT_EVIDENCE_BUILD_DEFAULT;
+    if (!s_enabled || s_inited) return;
     s_inited = 1;
     {
         const char *v = getenv("GENESIS_EVIDENCE_FRESH");
@@ -603,6 +616,7 @@ int runtime_evidence_has(RuntimeEvidenceKind kind, uint32_t addr)
 int runtime_evidence_add(RuntimeEvidenceKind kind, uint32_t addr, uint64_t frame,
                          const char *note)
 {
+    if (!s_inited) return 0;   /* disabled (release build without --debug) */
     if ((unsigned)kind >= RT_EVIDENCE_KIND_COUNT) return 0;
     EvFile *f = &s_files[kind];
     addr &= 0xFFFFFFu;
diff --git a/runner/runtime_evidence.h b/runner/runtime_evidence.h
index adee061..12afec6 100644
--- a/runner/runtime_evidence.h
+++ b/runner/runtime_evidence.h
@@ -58,8 +58,16 @@ typedef enum {
  * environment variable GENESIS_EVIDENCE_FRESH=1. */
 void runtime_evidence_request_fresh(void);
 
+/* Enable/disable the evidence files for this process. Development builds
+ * (GEN_ENABLE_TRACE) write them by default; a release build writes nothing
+ * unless the player passes --debug, so a normal session leaves no manifests
+ * next to the executable. Call before runtime_evidence_init; an explicit
+ * runtime_evidence_set_enabled() always wins over the build default. */
+void runtime_evidence_set_enabled(int on);
+
 /* Load (or rotate) every evidence file, count this launch as a new session,
- * and write the files back with the updated header. Idempotent. */
+ * and write the files back with the updated header. Idempotent, and a no-op
+ * when evidence is disabled. */
 void runtime_evidence_init(const char *game_short_name,
                            const char *game_display_name,
                            const uint8_t *rom, size_t rom_len);
