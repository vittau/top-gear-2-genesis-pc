+/* 1 when the folder holding X.app is an Applications folder (/Applications,
+ * ~/Applications or a subfolder of either). An installed app keeps user data
+ * and the imported cartridge in Application Support instead of loose files
+ * beside the bundle; any other folder stays a portable layout. */
+static int genesis_macos_is_installed_location(const char *parent)
+{
+    const char *at = parent;
+    if (!parent) return 0;
+    while ((at = strstr(at, "Applications")) != NULL) {
+        int starts = at == parent || at[-1] == '/';
+        char end = at[12];
+        if (starts && (end == '/' || end == '\0')) return 1;
+        at += 12;
+    }
+    return 0;
+}
