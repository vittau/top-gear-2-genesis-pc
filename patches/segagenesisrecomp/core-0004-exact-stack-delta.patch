     }
 
@@ -2672,10 +2738,6 @@ static void emit_instr(FILE *f, const GenesisRom *rom,
         if (mode == 1) {
             /* ADDQ to An: no flags */
             fprintf(f, "  g_cpu.A[%d] += %uu;\n", reg, imm);
-            /* Account data releases as well as whole return-slot skips. */
-            if (reg == 7 && imm > 0 && *has_sp_adjust) {
