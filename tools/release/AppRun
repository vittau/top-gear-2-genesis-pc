#!/bin/sh
# AppImage entry point. The runtime exports APPDIR (read-only mount) and
# APPIMAGE (the .AppImage file); the runner anchors settings, logs and saves
# next to $APPIMAGE while loading assets from usr/bin inside the mount.
set -eu
HERE=$(dirname "$(readlink -f "$0")")
exec "$HERE/usr/bin/TG2Recomp" "$@"
